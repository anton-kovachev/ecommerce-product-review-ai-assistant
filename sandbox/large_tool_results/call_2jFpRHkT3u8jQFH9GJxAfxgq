8\u0442\u0435\u043b\u043d\u0430\u0442\u0430 \u0441\u0432\u0435\u0449 ; \u0437\u0430 \u0447\u0438\u0441\u0442\u043e \u0438\u0437\u0433\u0430\u0440\u044f\u043d\u0435 \u0432 \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044f \u0438 \u0437\u0430 \u0432 \u0431\u044a\u0434\u0435\u0449\u0435.&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;/p&gt;&lt;h2&gt;\u041a\u0430\u043a\u0432\u043e \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u044f\u0432\u0430 \u0441\u0435\u0440\u0432\u0438\u0437\u0435\u043d \u043a\u043e\u043c\u043b\u0435\u043a\u0442 31 STIHL FS 131, FS 311, HT 130?&lt;/h2&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;\u0421\u0435\u0440\u0432\u0438\u0437\u043d\u0438\u044f\u0442 \u043a\u043e\u043c\u043f\u043b\u0435\u043a\u0442 31 \u0437\u0430 \u043c\u043e\u0434\u0435\u043b\u0438\u0442\u0435 STIHL FS 131, FS 311 \u0438 HT 130 \u0435 \u043f\u0440\u0435\u0434\u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d \u0437\u0430 \u0440\u0443\u0442\u0438\u043d\u043d\u0430 \u043f\u043e\u0434\u0434\u0440\u044a\u0436\u043a\u0430 \u0438 \u043e\u043f\u0442\u0438\u043c\u0430\u043b\u043d\u0430 \u0440\u0430\u0431\u043e\u0442\u0430 \u043d\u0430 \u0442\u0435\u0437\u0438 \u0443\u0440\u0435\u0434\u0438. \u041a\u043e\u043c\u043f\u043b\u0435\u043a\u0442\u044a\u0442 \u0432\u043a\u043b\u044e\u0447\u0432\u0430 \u043a\u043b\u044e\u0447\u043e\u0432\u0438 \u043a\u043e\u043c\u043f\u043e\u043d\u0435\u043d\u0442\u0438 \u043a\u0430\u0442\u043e \u0441\u0432\u0435\u0449, \u0432\u044a\u0437\u0434\u0443\u0448\u0435\u043d \u0444\u0438\u043b\u0442\u044a\u0440 \u0438 \u0433\u043e\u0440\u0438\u0432\u0435\u043d \u0444\u0438\u043b\u0442\u044a\u0440, \u043a\u043e\u0438\u0442\u043e \u0441\u0430 \u0441\u044a\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u0438 \u0437\u0430 \u043f\u043e\u0434\u0434\u044a\u0440\u0436\u0430\u043d\u0435 \u043d\u0430 \u0435\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0442\u0430 \u0438 \u0434\u044a\u043b\u0433\u043e\u0442\u0440\u0430\u0439\u043d\u043e\u0441\u0442\u0442\u0430 \u043d\u0430 \u0432\u0430\u0448\u0435\u0442\u043e \u043e\u0431\u043e\u0440\u0443\u0434\u0432\u0430\u043d\u0435.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;h3&gt;\u041a\u043e\u043c\u043f\u043e\u043d\u0435\u043d\u0442\u0438 \u043d\u0430 \u0421\u0435\u0440\u0432\u0438\u0437\u043d\u0438\u044f \u041a\u043e\u043c\u043f\u043b\u0435\u043a\u0442&lt;/h3&gt;&lt;p&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;\u0421\u0432\u0435\u0449&lt;/b&gt;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;\u0424\u0443\u043d\u043a\u0446\u0438\u044f: \u0417\u0430\u043f\u0430\u043b\u0438\u0442\u0435\u043b\u043d\u0430\u0442\u0430 \u0441\u0432\u0435\u0449 \u0435 \u043e\u0442\u0433\u043e\u0432\u043e\u0440\u043d\u0430 \u0437\u0430 \u0432\u044a\u0437\u043f\u043b\u0430\u043c\u0435\u043d\u044f\u0432\u0430\u043d\u0435\u0442\u043e \u043d\u0430 \u0433\u043e\u0440\u0438\u0432\u043d\u0430\u0442\u0430 \u0441\u043c\u0435\u0441 \u0432 \u0446\u0438\u043b\u0438\u043d\u0434\u044a\u0440\u0430 \u043d\u0430 \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044f. \u0422\u044f \u0435 \u043a\u043b\u044e\u0447\u043e\u0432\u0430 \u0437\u0430 \u043d\u0430\u0434\u0435\u0436\u0434\u043d\u043e\u0442\u043e \u0441\u0442\u0430\u0440\u0442\u0438\u0440\u0430\u043d\u0435 \u0438 \u0441\u0442\u0430\u0431\u0438\u043b\u043d\u0430\u0442\u0430 \u0440\u0430\u0431\u043e\u0442\u0430 \u043d\u0430 \u043c\u0430\u0448\u0438\u043d\u0430\u0442\u0430.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;\u041f\u043e\u0434\u043c\u044f\u043d\u0430: \u0420\u0435\u0434\u043e