30 \u0440\u0435\u0436\u0435\u0449\u0438\u044f \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442:&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;\u0426\u0435\u043d\u0442\u0440\u043e\u0431\u0435\u0436\u043d\u0438\u044f\u0442 \u0441\u044a\u0435\u0434\u0438\u043d\u0438\u0442\u0435\u043b \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u043d\u043e \u0432\u043a\u043b\u044e\u0447\u0432\u0430 \u0438 \u0438\u0437\u043a\u043b\u044e\u0447\u0432\u0430 \u0437\u0430\u0434\u0432\u0438\u0436\u0432\u0430\u043d\u0435\u0442\u043e \u043d\u0430 \u0440\u0435\u0436\u0435\u0449\u0438\u044f \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442 (\u043b\u0438\u043d\u0438\u044f, \u043d\u043e\u0436 \u0438\u043b\u0438 \u0434\u0438\u0441\u043a) \u0432 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442 \u043e\u0442 \u043e\u0431\u043e\u0440\u043e\u0442\u0438\u0442\u0435 \u043d\u0430 \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044f. \u041f\u0440\u0438 \u043d\u0438\u0441\u043a\u0438 \u043e\u0431\u043e\u0440\u043e\u0442\u0438 \u043d\u0430 \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044f (\u043d\u0430 \u043f\u0440\u0430\u0437\u0435\u043d \u0445\u043e\u0434), \u0441\u044a\u0435\u0434\u0438\u043d\u0438\u0442\u0435\u043b\u044f\u0442 \u043d\u0435 \u043f\u0440\u0435\u0434\u0430\u0432\u0430 \u0432\u044a\u0440\u0442\u044f\u0449 \u043c\u043e\u043c\u0435\u043d\u0442 \u043a\u044a\u043c \u0440\u0435\u0436\u0435\u0449\u0438\u044f \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442, \u043a\u043e\u0435\u0442\u043e \u043f\u0440\u0435\u0434\u043e\u0442\u0432\u0440\u0430\u0442\u044f\u0432\u0430 \u043d\u0435\u043d\u0443\u0436\u043d\u043e\u0442\u043e \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0435 \u043d\u0430 \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0430 \u0438 \u043f\u043e\u0432\u0438\u0448\u0430\u0432\u0430 \u0431\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u043e\u0441\u0442\u0442\u0430.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;2. \u041f\u0440\u0435\u0434\u043f\u0430\u0437\u0432\u0430\u043d\u0435 \u043d\u0430 \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044f \u0438 \u0440\u0435\u0436\u0435\u0449\u0438\u044f \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442:&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;\u0426\u0435\u043d\u0442\u0440\u043e\u0431\u0435\u0436\u043d\u0438\u044f\u0442 \u0441\u044a\u0435\u0434\u0438\u043d\u0438\u0442\u0435\u043b \u043f\u0440\u0435\u0434\u043f\u0430\u0437\u0432\u0430 \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044f \u0438 \u0440\u0435\u0436\u0435\u0449\u0438\u044f \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442 \u043e\u0442 \u0438\u0437\u043d\u043e\u0441\u0432\u0430\u043d\u0435 \u0438 \u043f\u0440\u0435\u0433\u0440\u044f\u0432\u0430\u043d\u0435, \u043a\u0430\u0442\u043e \u043e\u0441\u0438\u0433\u0443\u0440\u044f\u0432\u0430 \u043f\u043b\u0430\u0432\u043d\u043e \u0438 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u0438\u0440\u0430\u043d\u043e \u043f\u0440\u0435\u0434\u0430\u0432\u0430\u043d\u0435 \u043d\u0430 \u043c\u043e\u0449\u043d\u043e\u0441\u0442\u0442\u0430. \u0422\u043e\u0432\u0430 \u0443\u0434\u044a\u043b\u0436\u0430\u0432\u0430 \u0436\u0438\u0432\u043e\u0442\u0430 \u043d\u0430 \u043a\u043e\u043c\u043f\u043e\u043d\u0435\u043d\u0442\u0438\u0442\u0435 \u0438 \u043d\u0430\u043c\u0430\u043b\u044f\u0432\u0430 \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u0442\u0430 \u043e\u0442 \u0447\u0435\u0441\u0442\u0430 \u043f\u043e\u0434\u0434\u0440\u044a\u0436\u043a\u0430 \u0438 \u0440\u0435\u043c\u043e\u043d\u0442\u0438.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=