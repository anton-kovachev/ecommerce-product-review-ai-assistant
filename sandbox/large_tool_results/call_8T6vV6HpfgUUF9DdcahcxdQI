0\u043b\u0438 \u0438 \u043a\u043e\u043d\u0441\u0442\u0440\u0443\u043a\u0446\u0438\u044f&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;\u0412\u0438\u0441\u043e\u043a\u043e\u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435\u043d\u0438 \u043c\u0430\u0442\u0435\u0440\u0438\u0430\u043b\u0438: \u0420\u044a\u043a\u043e\u0445\u0432\u0430\u0442\u043a\u0430\u0442\u0430 \u0435 \u0438\u0437\u0440\u0430\u0431\u043e\u0442\u0435\u043d\u0430 \u043e\u0442 \u0437\u0434\u0440\u0430\u0432\u0438 \u0438 \u0443\u0441\u0442\u043e\u0439\u0447\u0438\u0432\u0438 \u043c\u0430\u0442\u0435\u0440\u0438\u0430\u043b\u0438, \u043a\u043e\u0438\u0442\u043e \u043e\u0441\u0438\u0433\u0443\u0440\u044f\u0432\u0430\u0442 \u0434\u044a\u043b\u0433\u043e\u0442\u0440\u0430\u0439\u043d\u043e\u0441\u0442 \u0438 \u043d\u0430\u0434\u0435\u0436\u0434\u043d\u043e\u0441\u0442 \u043f\u0440\u0438 \u0438\u043d\u0442\u0435\u043d\u0437\u0438\u0432\u043d\u0430 \u0443\u043f\u043e\u0442\u0440\u0435\u0431\u0430.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;\u0415\u0440\u0433\u043e\u043d\u043e\u043c\u0438\u0447\u0435\u043d \u0434\u0438\u0437\u0430\u0439\u043d: \u0422\u0440\u044a\u0431\u043d\u0430\u0442\u0430 \u0440\u044a\u043a\u043e\u0445\u0432\u0430\u0442\u043a\u0430 \u0435 \u043f\u0440\u043e\u0435\u043a\u0442\u0438\u0440\u0430\u043d\u0430 \u0441 \u043e\u0433\u043b\u0435\u0434 \u043d\u0430 \u0435\u0440\u0433\u043e\u043d\u043e\u043c\u0438\u044f\u0442\u0430, \u0437\u0430 \u0434\u0430 \u043e\u0441\u0438\u0433\u0443\u0440\u0438 \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u0435\u043d \u043a\u043e\u043c\u0444\u043e\u0440\u0442 \u0438 \u043c\u0438\u043d\u0438\u043c\u0430\u043b\u043d\u043e \u043d\u0430\u043f\u0440\u0435\u0436\u0435\u043d\u0438\u0435 \u0432\u044a\u0440\u0445\u0443 \u0440\u044a\u0446\u0435\u0442\u0435 \u0438 \u0440\u0430\u043c\u0435\u043d\u0435\u0442\u0435.&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;\u0421\u0442\u0430\u0431\u0438\u043b\u043d\u043e\u0441\u0442 \u0438 \u043a\u043e\u043d\u0442\u0440\u043e\u043b&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;\u0421\u0442\u0430\u0431\u0438\u043b\u043d\u043e \u0437\u0430\u0445\u0432\u0430\u0449\u0430\u043d\u0435: \u0415\u0440\u0433\u043e\u043d\u043e\u043c\u0438\u0447\u043d\u0438\u044f\u0442 \u0434\u0438\u0437\u0430\u0439\u043d \u0438 \u043f\u043e\u0434\u0445\u043e\u0434\u044f\u0449\u0430\u0442\u0430 \u0444\u043e\u0440\u043c\u0430 \u043d\u0430 \u0440\u044a\u043a\u043e\u0445\u0432\u0430\u0442\u043a\u0430\u0442\u0430 \u043e\u0441\u0438\u0433\u0443\u0440\u044f\u0432\u0430\u0442 \u0441\u0442\u0430\u0431\u0438\u043b\u043d\u043e \u0438 \u0441\u0438\u0433\u0443\u0440\u043d\u043e \u0437\u0430\u0445\u0432\u0430\u0449\u0430\u043d\u0435, \u043a\u043e\u0435\u0442\u043e \u043f\u043e\u0434\u043e\u0431\u0440\u044f\u0432\u0430 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u0430 \u0432\u044a\u0440\u0445\u0443 \u0442\u0440\u0438\u043c\u0435\u0440\u0430.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;\u0423\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u043d\u0430 \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0430: \u0422\u0440\u044a\u0431\u043d\u0430\u0442\u0430 \u0440\u044a\u043a\u043e\u0445\u0432\u0430\u0442\u043a\u0430 \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u0432\u0430 \u043b\u0435\u0441\u043d\u043e \u0438 \u0442\u043e\u0447\u043d\u043e \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u043d\u0430 \u0442\u0440\u0438\u043c\u0435\u0440\u0430, \u043a\u043e\u0435\u0442\u043e \u0435 \u043e\u0441\u043e\u0431\u0435\u043d\u043e \u0432\u0430\u0436\u043d\u043e \u