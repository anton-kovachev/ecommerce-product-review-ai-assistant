\u043c\u043f\u0435\u043d\u0441\u0430\u0446\u0438\u044f \u043f\u0440\u0438 \u043f\u0440\u043e\u043c\u044f\u043d\u0430 \u043d\u0430 \u0443\u0441\u043b\u043e\u0432\u0438\u044f\u0442\u0430 \u043d\u0430 \u0440\u0430\u0431\u043e\u0442\u0430. \u0410\u043a\u043e \u043f\u0440\u0438\u043e\u0440\u0438\u0442\u0435\u0442\u044a\u0442 \u0432\u0438 \u0435 \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u043d\u043e \u043d\u0438\u0441\u043a\u043e \u0442\u0435\u0433\u043b\u043e \u0438 \u043b\u0435\u0441\u043d\u0430 \u043c\u0430\u043d\u0435\u0432\u0440\u0435\u043d\u043e\u0441\u0442 \u043f\u0440\u0438\r\n    \u0440\u0435\u0434\u043a\u0438 \u0433\u0440\u0430\u0434\u0438\u043d\u0441\u043a\u0438 \u0437\u0430\u0434\u0430\u0447\u0438, &lt;/span&gt;&lt;strong&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;MS 182&lt;/span&gt;&lt;/strong&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt; \u043e\u0441\u0442\u0430\u0432\u0430 \u043e\u0442\u043b\u0438\u0447\u043d\u0430, \u043f\u043e-\u043b\u0435\u043a\u0430 \u0430\u043b\u0442\u0435\u0440\u043d\u0430\u0442\u0438\u0432\u0430.&lt;/span&gt;&lt;/p&gt;\r\n\r\n  &lt;p style=&quot;margin-top:12px;&quot;&gt;&lt;br&gt;&lt;/p&gt;\r\n\r\n  &lt;h2 style=&quot;font-size:18px; margin-top:16px;&quot;&gt;\u041a\u0440\u0430\u0442\u043a\u043e \u0440\u0435\u0437\u044e\u043c\u0435 \u0438 \u043f\u0440\u0435\u043f\u043e\u0440\u044a\u043a\u0430&lt;/h2&gt;&lt;p style=&quot;font-size: 18px; margin-top: 16px;&quot;&gt;&lt;br&gt;&lt;/p&gt;\r\n  &lt;p&gt;\r\n    &lt;strong&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;STIHL MS 212&lt;/span&gt;&lt;/strong&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&amp;nbsp;C-BE \u043a\u043e\u043c\u0431\u0438\u043d\u0438\u0440\u0430 \u043c\u043e\u0449\u043d\u043e\u0441\u0442, \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u043d\u0438 \u0441\u0435\u0440\u0432\u0438\u0437\u043d\u0438 \u0440\u0435\u0448\u0435\u043d\u0438\u044f \u0438 \u0443\u0434\u043e\u0431\u0441\u0442\u0432\u043e \u043f\u0440\u0438 \u0435\u043a\u0441\u043f\u043b\u043e\u0430\u0442\u0430\u0446\u0438\u044f. \u0422\u043e\u0432\u0430 \u0433\u043e \u043f\u0440\u0430\u0432\u0438\r\n    \u0438\u0434\u0435\u0430\u043b\u0435\u043d \u0438\u0437\u0431\u043e\u0440 \u0437\u0430 \u043f\u043e\u0442\u0440\u0435\u0431\u0438\u0442\u0435\u043b\u0438, \u043a\u043e\u0438\u0442\u043e \u0442\u044a\u0440\u0441\u044f\u0442 \u043d\u0430\u0434\u0435\u0436\u0434\u0435\u043d \u0442\u0440\u0438\u043e\u043d \u0437\u0430 \u0442\u0435\u0436\u043a\u0438 \u0434\u043e\u043c\u0430\u0448\u043d\u0438 \u0437\u0430\u0434\u0430\u0447\u0438 \u0438 \u0440\u0435\u0434\u043e\u0432\u043d\u0430 \u0443\u043f\u043e\u0442\u0440\u0435\u0431\u0430. \u0410\u043a\u043e \u0436\u0435\u043b\u0430\u0435\u0442\u0435 \u043f\u043e-\u043b\u0435\u043a\u0430\r\n    \u043c\u0430\u0448\u0438\u043d\u0430 \u0437\u0430 \u043f\u043e-\u0440\u0435\u0434\u043a\u0438 \u0438 \u043b\u0435\u043a\u0438 \u0437\u0430\u0434\u0430\u0447\u0438 \u2014 \u0440\u0430\u0437\u0433\u043b\u0435\u0434\u0430\u0439\u0442\u0435 MS 182; \u0430\u043a\u043e \u0438\u0441\u043a\u0430\u0442\u0435 \u0441\u044a\u0449\u0430\u0442\u0430 \u043c\u043e\u0449\u043d\u043e\u0441\u0442 \u0441 \u0434\u043e\u043f\u044a\u043b\u043d\u0438\u0442\u0435\u043b\u043d\u0438 \u043f\u043e\u043c\u043e\u0449\u043d\u0438 \u0444\u0443\u043d\u043a\u0446\u0438\u0438 \u0437\u0430\r\n    \u0441\u0442\u0430\u0440\u0442\u0438\u0440\u0430\u043d\u0435 \u0438 \u0431\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u043e\u0441\u0442 \u2014 \u0432\u0435\u0440\u0441\u0438\u044f\u0442\u0430 &lt;/span&gt;&lt;strong&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;MS 212 C&lt;/span&gt;&lt;/strong&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt; \u0435 \u043e\u0442\u043b\u0438\u0447\u043d\u0430 \u043e\u043f\u0446\u0438\u044f.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;\r\n  \r\n  \r\n  \r\n\r\n&lt;/div&gt;\r\n\r\n&lt;div style=&quot;font-family: 'Open Sans', Arial, sans-serif; font-size:14px;&quot;&gt;\r\n\r\n  &lt;h1 style=&quot;font-size:22px; margin:18px 0 8px;&quot;&gt;\u0421\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043d\u0430 \u0448\u0438\u043d\u0430 \u0438 \u0432\u0435\u0440\u0438\u0433\u0430 \u0437\u0430 &lt;strong&gt;STIHL MS 212 C-BE&lt;/strong&gt;&lt;/h1&gt;&lt;h1 style=&quot;font-size:22px; margin:18px 0 8px;&quot;&gt;&lt;strong&gt;&lt;br&gt;&lt;/strong&gt;&lt;/h1&gt;\r\n\r\n  &lt;p&gt;\r\n    &lt;span style=&quot;font-size: 14px;&quot;&gt;\u041f\u0440\u0438 \u0438\u0437\u0431\u043e\u0440\u0430 \u043d\u0430 \u043f\u043e\u0434\u0445\u043e\u0434\u044f\u0449\u0438 \u043a\u043e\u043d\u0441\u0443\u043c\u0430\u0442\u0438\u0432\u0438 \u0437\u0430 \u0432\u0430\u0448\u0438\u044f &lt;/span&gt;&lt;strong&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;STIHL MS 212&lt;/span&gt;&lt;/strong&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&amp;nbsp;CE \u0435 \u0432\u0430\u0436\u043d\u043e \u0434\u0430 \u0437\u043d\u0430\u0435\u0442\u0435 \u043a\u043e\u044f \u0435 \u043f\u0440\u0435\u043f\u043e\u0440\u044a\u0447\u0438\u0442\u0435\u043b\u043d\u0430\u0442\u0430\r\n    &lt;/span&gt;&lt;strong&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;\u0448\u0438\u043d\u0430&lt;/span&gt;&lt;/strong&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt; \u0438 \u043a\u043e\u044f \u0435 \u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043d\u0430\u0442\u0430 &lt;/span&gt;&lt;strong&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;\u0432\u0435\u0440\u0438\u0433\u0430&lt;/span&gt;&lt;/strong&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;. \u0422\u043e\u0432\u0430 \u043e\u0441\u0438\u0433\u0443\u0440\u044f\u0432\u0430 \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u043d\u0430 \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0438\u0442\u0435\u043b\u043d\u043e\u0441\u0442,\r\n    \u0431\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u043e\u0441\u0442 \u0438 \u043f\u043e-\u0434\u044a\u043b\u044a\u0433 \u0436\u0438\u0432\u043e\u0442 \u043d\u0430 \u043c\u0430\u0448\u0438\u043d\u0430\u0442\u0430&lt;/span&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;.&lt;/span&gt;&lt;/p&gt;\r\n\r\n  &lt;h2 style=&quot;font-size:18px; margin-top:16px;&quot;&gt;&lt;br&gt;&lt;/h2&gt;&lt;h2 style=&quot;font-size:18px; margin-top:16px;&quot;&gt;\u0428\u0438\u043d\u0430 \u0437\u0430 STIHL MS 212 C&lt;/h2&gt;&lt;p style=&quot;font-size: 18px; margin-top: 16px;&quot;&gt;&lt;br&gt;&lt;/p&gt;\r\n  &lt;ul&gt;\r\n    &lt;li&gt;&lt;strong&gt;STIHL Light 04&lt;/strong&gt;&lt;/li&gt;\r\n    &lt;li&gt;&lt;strong&gt;\u0414\u044a\u043b\u0436\u0438\u043d\u0430:&lt;/strong&gt;&amp;nbsp;35 \u0441\u043c. \u0432 \u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043d\u0430\u0442\u0430 \u043a\u043e\u043d\u0444\u0438\u0433\u0443\u0440\u0430\u0446\u0438\u044f&lt;/li&gt;\r\n    &lt;li&gt;&lt;strong&gt;\u041f\u0440\u0435\u0434\u0438\u043c\u0441\u0442\u0432\u0430:&lt;/strong&gt; \u043f\u043e-\u043d\u0438\u0441\u043a\u043e \u0442\u0435\u0433\u043b\u043e, \u043e\u0442\u043b\u0438\u0447\u0435\u043d \u0431\u0430\u043b\u0430\u043d\u0441 \u0438 \u043f\u043e-\u043b\u0435\u0441\u043d\u043e \u0440\u044f\u0437\u0430\u043d\u0435&lt;/li&gt;\r\n  &lt;/ul&gt;\r\n\r\n  &lt;h2 style=&quot;font-size:18px; margin-top:16px;&quot;&gt;&lt;br&gt;&lt;/h2&gt;&lt;h2 style=&quot;font-size:18px; margin-top:16px;&quot;&gt;\u0412\u0435\u0440\u0438\u0433\u0430 \u0437\u0430 STIHL MS 212 C&lt;/h2&gt;&lt;p style=&quot;font-size: 18px; margin-top: 16px;&quot;&gt;&lt;br&gt;&lt;/p&gt;\r\n  &lt;ul&gt;\r\n    &lt;li&gt;&lt;strong&gt;\u0421\u0442\u044a\u043f\u043a\u0430:&lt;/strong&gt; 3/8&quot; P (Pitch 3/8 P)&lt;/li&gt;\r\n    &lt;li&gt;&lt;strong&gt;\u0422\u0438\u043f:&lt;/strong&gt; \u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043d\u0430 OILOMATIC\u00ae, \u043d\u0430\u043b\u0438\u0447\u043d\u0430 \u0438 \u0432\u044a\u0432 \u0432\u0435\u0440\u0441\u0438\u0438 Low Kickback \u0437\u0430 \u043f\u043e-\u0433\u043e\u043b\u044f\u043c\u0430 \u0431\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u043e\u0441\u0442&lt;/li&gt;\r\n    &lt;li&gt;&lt;strong&gt;\u041f\u0440\u0435\u0434\u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0435:&lt;/strong&gt; \u0447\u0438\u0441\u0442\u043e \u0438 \u0431\u044a\u0440\u0437\u043e \u0440\u044f\u0437\u0430\u043d\u0435, \u043f\u043e\u0434\u0445\u043e\u0434\u044f\u0449\u0430 \u0437\u0430 \u0434\u044a\u0440\u0432\u0430 \u0437\u0430 \u043e\u0433\u0440\u0435\u0432 \u0438 \u043e\u0431\u0449\u0430 \u0434\u043e\u043c\u0430\u0448\u043d\u0430 \u0443\u043f\u043e\u0442\u0440\u0435\u0431\u0430&lt;/li&gt;\r\n  &lt;/ul&gt;\r\n\r\n  &lt;h2 style=&quot;font-size:18px; margin-top:16px;&quot;&gt;&lt;br&gt;&lt;/h2&gt;&lt;p style=&quot;font-size: 18px; margin-top: 16px;&quot;&gt;&lt;br&gt;&lt;/p&gt;\r\n  &lt;table style=&quot;width:100%; border-collapse:collapse; margin:10px 0 20px; font-size:14px;&quot;&gt;\r\n    &lt;thead&gt;\r\n      &lt;tr style=&quot;background:#f6f6f6;&quot;&gt;\r\n        &lt;th style=&quot;text-align:left; padding:10px; border:1px solid #e0e0e0;&quot;&gt;\u041c\u043e\u0434\u0435\u043b&lt;/th&gt;\r\n        &lt;th style=&quot;text-align:left; padding:10px; border:1px solid #e0e0e0;&quot;&gt;\u0428\u0438\u043d\u0430&lt;/th&gt;\r\n        &lt;th style=&quot;text-align:left; padding:10px; border:1px solid #e0e0e0;&quot;&gt;\u0412\u0435\u0440\u0438\u0433\u0430&lt;/th&gt;\r\n      &lt;/tr&gt;\r\n    &lt;/thead&gt;\r\n    &lt;tbody&gt;\r\n      &lt;tr&gt;\r\n        &lt;td style=&quot;padding:10px; border:1px solid #e0e0e0;&quot;&gt;&lt;strong&gt;STIHL MS 212&lt;/strong&gt;&lt;/td&gt;\r\n        &lt;td style=&quot;padding:10px; border:1px solid #e0e0e0;&quot;&gt;Light 04 \u2014 35 \u0441\u043c.&lt;/td&gt;\r\n        &lt;td style=&quot;padding:10px; border:1px solid #e0e0e0;&quot;&gt;3/8&quot; P, \u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043d\u0430 OILOMATIC\u00ae, \u043d\u0430\u043b\u0438\u0447\u043d\u0430 \u0438 \u0441 Low Kickback&lt;/td&gt;\r\n      &lt;/tr&gt;\r\n      &lt;tr style=&quot;background:#fafafa;&quot;&gt;\r\n        &lt;td style=&quot;padding:10px; border:1px solid #e0e0e0;&quot;&gt;&lt;strong&gt;