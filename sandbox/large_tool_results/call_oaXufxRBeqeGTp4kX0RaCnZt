 margin-top:16px;&quot;&gt;&lt;br&gt;&lt;/h2&gt;&lt;h2 style=&quot;font-size:18px; margin-top:16px;&quot;&gt;\u041f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u0441\u044a\u0432\u0435\u0442\u0438 \u0437\u0430 \u0435\u043a\u0441\u043f\u043b\u043e\u0430\u0442\u0430\u0446\u0438\u044f \u0438 \u043e\u0431\u0441\u043b\u0443\u0436\u0432\u0430\u043d\u0435&lt;/h2&gt;&lt;p style=&quot;font-size: 18px; margin-top: 16px;&quot;&gt;&lt;br&gt;&lt;/p&gt;\r\n  &lt;ul&gt;\r\n    &lt;li&gt;&lt;strong&gt;\u0417\u0430\u0449\u0438\u0442\u0430 \u043d\u0430 \u0441\u043b\u0443\u0445\u0430 \u0438 \u043e\u0447\u0438\u0442\u0435:&lt;/strong&gt; \u0432\u0438\u043d\u0430\u0433\u0438 \u0438\u0437\u043f\u043e\u043b\u0437\u0432\u0430\u0439\u0442\u0435 \u0437\u0430\u0449\u0438\u0442\u043d\u0430 \u043a\u0430\u0441\u043a\u0430, \u043e\u0447\u0438\u043b\u0430 \u0438 \u0441\u043b\u0443\u0448\u0430\u043b\u043a\u0438, \u043a\u043e\u0433\u0430\u0442\u043e \u0440\u0430\u0431\u043e\u0442\u0438\u0442\u0435 \u0441 \u0442\u0440\u0438\u043e\u043d\u0430.&lt;/li&gt;\r\n    &lt;li&gt;&lt;strong&gt;\u0413\u0440\u0438\u0436\u0430 \u0437\u0430 \u0432\u044a\u0437\u0434\u0443\u0448\u043d\u0438\u044f \u0444\u0438\u043b\u0442\u044a\u0440:&lt;/strong&gt; \u0434\u044a\u043b\u0433\u0438\u044f\u0442 \u0436\u0438\u0432\u043e\u0442 \u043d\u0430 \u0444\u0438\u043b\u0442\u044a\u0440\u0430 \u043d\u0430\u043c\u0430\u043b\u044f\u0432\u0430 \u0447\u0435\u0441\u0442\u043e\u0442\u0430\u0442\u0430 \u043d\u0430 \u043f\u043e\u0447\u0438\u0441\u0442\u0432\u0430\u043d\u0435, \u043d\u043e \u043f\u0435\u0440\u0438\u043e\u0434\u0438\u0447\u043d\u0430\u0442\u0430 \u043f\u0440\u043e\u0432\u0435\u0440\u043a\u0430 \u0435 \u0437\u0430\u0434\u044a\u043b\u0436\u0438\u0442\u0435\u043b\u043d\u0430, \u043e\u0441\u043e\u0431\u0435\u043d\u043e \u043f\u0440\u0438 \u043f\u0440\u0430\u0448\u043d\u0438 \u0443\u0441\u043b\u043e\u0432\u0438\u044f.&lt;/li&gt;\r\n    &lt;li&gt;&lt;strong&gt;\u041f\u0440\u0430\u0432\u0438\u043b\u043d\u043e \u043e\