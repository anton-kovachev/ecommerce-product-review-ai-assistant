&gt;\r\n\r\n  &lt;h2 style=&quot;font-size:18px; margin-top:16px;&quot;&gt;\u041a\u043b\u044e\u0447\u043e\u0432\u0438 \u0442\u0435\u0445\u043d\u0438\u0447\u0435\u0441\u043a\u0438 \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043a\u0438&lt;/h2&gt;&lt;p style=&quot;font-size: 18px; margin-top: 16px;&quot;&gt;&lt;br&gt;&lt;/p&gt;\r\n  &lt;ul&gt;\r\n    &lt;li&gt;&lt;strong&gt;\u0420\u0430\u0431\u043e\u0442\u0435\u043d \u043e\u0431\u0435\u043c:&lt;/strong&gt; 38.6 \u0441\u043c\u00b3&lt;/li&gt;\r\n    &lt;li&gt;&lt;strong&gt;\u041c\u043e\u0449\u043d\u043e\u0441\u0442:&lt;/strong&gt; 1.80 kW (\u2248 2.40 \u043a.\u0441.)&lt;/li&gt;\r\n    &lt;li&gt;&lt;strong&gt;CO\u2082:&lt;/strong&gt; 849 \u0433/kWh&lt;/li&gt;\r\n    &lt;li&gt;&lt;strong&gt;\u0422\u0435\u0433\u043b\u043e (\u0431\u0435\u0437 \u0433\u043e\u0440\u0438\u0432\u043e):&lt;/strong&gt; 4.6 \u043a\u0433 (\u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043d\u0430 \u0432\u0435\u0440\u0441\u0438\u044f) / 5.28 \u043a\u0433 (\u0440\u0430\u0437\u043b\u0438\u0447\u043d\u0438 \u043a\u043e\u043d\u0444\u0438\u0433\u0443\u0440\u0430\u0446\u0438\u0438)&lt;/li&gt;\r\n    &lt;li&gt;&lt;strong&gt;\u0422\u0435\u0433\u043b\u043e \u0437\u0430 \u0435\u0434\u0438\u043d\u0438\u0446\u0430 \u043c\u043e\u0449\u043d\u043e\u0441\u0442:&lt;/strong&gt; 2.60 \u043a\u0433/kW&lt;/li&gt;\r\n    &lt;li&gt;&lt;strong&gt;\u0414\u044a\u043b\u0436\u0438\u043d\u0430 \u043d\u0430 \u0448\u0438\u043d\u0430\u0442\u0430:&lt;/strong&gt; 35 \u0441\u043c (\u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442), \u043e\u043f\u0446\u0438\u0438 \u0434\u043e 40 \u0441\u043c&lt;/li&gt;\r\n    &lt;li&gt;&lt;strong&gt;\u0421\u0442\u044a\u043f\u043a\u0430 \u043d\u0430 \u0432\u0435\u0440\u0438\u0433\u0430\u0442\u0430:&lt;/strong&gt; 3/8&quot; P&lt;/li&gt;\r\n    &lt;li&gt;&lt;strong&gt;\u041d\u0438\u0432\u043e \u043d\u0430 \u0437\u0432\u0443\u043a\u043e\u0432\u043e \u043d\u0430\u043b\u044f\u0433\u0430\u043d\u0435:&lt;/strong&gt; 103 dB(A)&lt;/li&gt;\r\n    &lt;li&gt;&lt;strong&gt;\u041d\u0438\u0432\u043e \u043d\u0430 \u0437\u0432\u0443\u043a\u043e\u0432\u0430 \u043c\u043e\u0449\u043d\u043e\u0441\u0442:&lt;/strong&gt; 113 dB(A)&lt;/li&gt;\r\n    &lt;li&gt;&lt;strong&gt;\u041d\u0438\u0432\u043e \u043d\u0430 \u0432\u0438\u0431\u0440\u0430\u0446\u0438\u0438\u0442\u0435:&lt;/strong&gt; \u043b\u044f\u0432\u043e 3.1 \u043c/\u0441\u0435\u043a\u00b2, \u0434\u044f\u0441\u043d\u043e 3.7 \u043c/\u0441\u0435\u043a\u00b2&lt;/li&gt;\r\n    &lt;li&gt;&lt;strong&gt;\u0414\u0440\u0443\u0433\u0438 \u0444\u0443\u043d\u043a\u0446\u0438\u0438:&lt;/strong&gt; \u0441\u0442\u0440\u0430\u043d\u0438\u0447\u043d\u043e \u043e\u043f\u044a\u0432\u0430\u043d\u0435 \u043d\u0430 \u0432\u0435\u0440\u0438\u0433\u0430\u0442\u0430, 2-MIX \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b, STIHL \u0430\u043d\u0442\u0438\u0432\u0438\u0431\u0440\u0430\u0446\u0438\u043e\u043d\u043d\u0430 \u0441\u0438\u0441\u0442\u0435\u043c\u0430,\r\n      \u043a\u043e\u043c\u043f\u0435\u043d\u0441\u0430\u0442\u043e\u0440, \u0431\u0443\u043a\u0441\u0430 \u0437\u0430 \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0430, \u0440\u0435\u0433\u0443\u043b\u0438\u0440\u0443\u0435\u043c \u043a\u0430\u0440\u0431\u0443\u0440\u0430\u0442\u043e\u0440 \u0437\u0430 \u0440\u0430\u0431\u043e\u0442\u0430 \u043d\u0430 \u0440\u0430\u0437\u043b\u0438\u0447\u043d\u0438 \u043d\u0430\u0434\u043c\u043e\u0440\u0441\u043a\u0438 \u0432\u0438\u0441\u043e\u0447\u0438\u043d\u0438, \u0434\u044a\u043b\u044a\u0433 \u0436\u0438\u0432\u043e\u0442 \u043d\u0430\r\n      \u0432\u044a\u0437\u0434\u0443\u0448\u043d\u0438\u044f \u0444\u0438\u043b\u0442\u044a\u0440; \u043e\u043f\u0446\u0438\u044f \u043f\u043e\u043b\u0438\u0430\u043c\u0438\u0434\u043d\u0438 \u0444\u0438\u043b\u0442\u0440\u0438 \u0437\u0430 \u0440\u0430\u0431\u043e\u0442\u0430 \u043f\u0440\u0438 \u0441\u043d\u044f\u0433.\r\n    &lt;/li&gt;\r\n  &lt;/ul&gt;\r\n\r\n  &lt;h2 style=&quot;font-size:18px; margin-top:16px;&quot;&gt;&lt;br&gt;&lt;/h2&gt;&lt;h2 style=&quot;font-size:18px; margin-top:16px;&quot;&gt;\u0417\u0430 \u043a\u0430\u043a\u0432\u043e \u0435 \u043f\u043e\u0434\u0445\u043e\u0434\u044f\u0449 STIHL MS 212 C-BE?&lt;/h2&gt;&lt;p style=&quot;font-size: 18px; margin-top: 16px;&quot;&gt;&lt;br&gt;&lt;/p&gt;\r\n  &lt;p&gt;\r\n    &lt;strong&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;STIHL MS 212 C-BE&lt;/span&gt;&lt;/strong&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt; \u0435 \u043f\u0440\u043e\u0435\u043a\u0442\u0438\u0440\u0430\u043d \u0437\u0430 \u0448\u0438\u0440\u043e\u043a \u043a\u0440\u044a\u0433 \u043e\u0442 \u0437\u0430\u0434\u0430\u0447\u0438 \u0432 \u0434\u043e\u043c\u0430\u0448\u043d\u0438\u044f \u0438 \u043f\u043e\u043b\u0443-\u043f\u0440\u043e\u0444\u0435\u0441\u0438\u043e\u043d\u0430\u043b\u043d\u0438\u044f \u0441\u0435\u0433\u043c\u0435\u043d\u0442:&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;\r\n  &lt;/span&gt;&lt;/p&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;\r\n  &lt;/span&gt;&lt;ul&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;\r\n    &lt;/span&gt;&lt;li&gt;&lt;strong&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;\u0420\u044f\u0437\u0430\u043d\u0435 \u043d\u0430 \u0434\u044a\u0440\u0432\u0430 \u0437\u0430 \u043e\u0433\u0440\u0435\u0432&lt;/span&gt;&lt;/strong&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt; \u2014 \u0441\u0442\u0430\u0431\u0438\u043b\u043d\u0430 \u043c\u043e\u0449\u043d\u043e\u0441\u0442 \u0438 \u0432\u044a\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442 \u0437\u0430 \u0440\u0430\u0431\u043e\u0442\u0430 \u0441 \u0448\u0438\u043d\u0438 \u0434\u043e 35\u201340 \u0441\u043c \u043f\u0440\u0430\u0432\u044f\u0442\r\n      \u043c\u043e\u0434\u0435\u043b\u0430 \u0435\u0444\u0435\u043a\u0442\u0438\u0432\u0435\u043d \u0437\u0430 \u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043d\u0438 \u0438 \u043f\u043e-\u043e\u0431\u0435\u043c\u043d\u0438 \u0442\u0440\u0443\u043f\u0438.\r\n    &lt;/span&gt;&lt;/li&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;\r\n    &lt;/span&gt;&lt;li&gt;&lt;strong&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;\u041f\u043e\u0434\u0434\u044a\u0440\u0436\u0430\u043d\u0435 \u043d\u0430 \u0434\u0432\u043e\u0440\u043d\u043e \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u043e&lt;/span&gt;&lt;/strong&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt; \u2014 \u0441\u0432\u0430\u043b\u044f\u043d\u0435 \u043d\u0430 \u043f\u0430\u0434\u043d\u0430\u043b\u0438 \u043a\u043b\u043e\u043d\u0438, \u043f\u043e\u0447\u0438\u0441\u0442\u0432\u0430\u043d\u0435 \u043d\u0430 \u0431\u0443\u0440\u0435\u043d\u0438 \u0438 \u0445\u0440\u0430\u0441\u0442\u0438,\r\n      \u0438\u0437\u0440\u044f\u0437\u0432\u0430\u043d\u0435 \u043d\u0430 \u0442\u044a\u043d\u043a\u0438 \u0441\u0442\u0432\u043e\u043b\u043e\u0432\u0435.\r\n    &lt;/span&gt;&lt;/li&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;\r\n    &lt;/span&gt;&lt;li&gt;&lt;strong&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;\u041b\u0435\u043a\u0430 \u0434\u044a\u0440\u0432\u043e\u0434\u043e\u0431\u0438\u0432\u043d\u0430 \u0440\u0430\u0431\u043e\u0442\u0430&lt;/span&gt;&lt;/strong&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt; \u2014 \u043f\u043e\u0434\u0445\u043e\u0434\u044f\u0449 \u0437\u0430 \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u0438\u0446\u0438 \u043d\u0430 \u0432\u0438\u043b\u0438 \u0438 \u043a\u044a\u0449\u0438, \u043a\u043e\u0438\u0442\u043e \u0447\u0435\u0441\u0442\u043e \u0441\u0435 \u0433\u0440\u0438\u0436\u0430\u0442 \u0437\u0430 \u0433\u043e\u0440\u0441\u043a\u0438\r\n      \u043c\u0430\u0441\u0438\u0432\u0438 \u0432 \u0438\u043c\u043e\u0442\u0430 \u0441\u0438.\r\n    &lt;/span&gt;&lt;/li&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;\r\n    &lt;/span&gt;&lt;li&gt;&lt;strong&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;\u0420\u0430\u0431\u043e\u0442\u0430 \u043f\u0440\u0438 \u0440\u0430\u0437\u043d\u043e\u043e\u0431\u0440\u0430\u0437\u043d\u0438 \u0443\u0441\u043b\u043e\u0432\u0438\u044f&lt;/span&gt;&lt;/strong&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt; \u2014 \u043a\u043e\u043c\u043f\u0435\u043d\u0441\u0430\u0442\u043e\u0440 \u0438 \u0440\u0435\u0433\u0443\u043b\u0438\u0440\u0443\u0435\u043c \u043a\u0430\u0440\u0431\u0443\u0440\u0430\u0442\u043e\u0440 \u043e\u0441\u0438\u0433\u0443\u0440\u044f\u0432\u0430\u0442 \u043f\u043e-\u0434\u043e\u0431\u0440\u043e \u043f\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u0435 \u043f\u0440\u0438\r\n      \u0437\u0430\u043c\u044a\u0440\u0441\u0435\u043d\u0438 \u0444\u0438\u043b\u0442\u0440\u0438 \u0438 \u0440\u0430\u0437\u043b\u0438\u0447\u043d\u0438 \u043d\u0430\u0434\u043c\u043e\u0440\u0441\u043a\u0438 \u0432\u0438\u0441\u043e\u0447\u0438\u043d\u0438.\r\n    &lt;/span&gt;&lt;/li&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;\r\n  &lt;/span&gt;&lt;/ul&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;\r\n\r\n  &lt;/span&gt;&lt;h2 style=&quot;font-size:18px; margin-top:16px;&quot;&gt;&lt;br&gt;&lt;/h2&gt;&lt;h2 style=&quot;font-size:18px; margin-top:16px;&quot;&gt;\u0417\u0430 \u043a\u043e\u0433\u043e \u0435 \u043f\u043e\u0434\u0445\u043e\u0434\u044f\u0449 STIHL MS 212 C-BE?&lt;/h2&gt;&lt;p style=&quot;font-size: 18px; margin-top: 16px;&quot;&gt;&lt;br&gt;&lt;/p&gt;\r\n  &lt;p&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;MS 212 C_BE \u0435 \u043e\u0442\u043b\u0438\u0447\u0435\u043d \u0438\u0437\u0431\u043e\u0440 \u0437\u0430:&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;\r\n  &lt;ul&gt;\r\n    &lt;li&gt;\u0421\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u0438\u0446\u0438 \u043d\u0430 \u0434\u043e\u043c\u0430, \u043a\u043e\u0438\u0442\u043e \u0442\u044a\u0440\u0441\u044f\u0442 \u043f\u043e-\u043c\u043e\u0449\u0435\u043d \u0438 \u043f\u043e-\u0443\u0441\u0442\u043e\u0439\u0447\u0438\u0432 \u043e\u0442 \u0431\u0430\u0437\u043e\u0432\u0438\u0442\u0435 \u0445\u043e\u0431\u0438 \u043c\u043e\u0434\u0435\u043b\u0438 \u0442\u0440\u0438\u043e\u043d.&lt;/li&gt;\r\n    &lt;li&gt;\u0425\u043e\u0440\u0430 \u0441 \u043c\u0430\u043b\u043a\u0438 \u0444\u0435\u0440\u043c\u0438, \u0432\u0438\u043b\u0438 \u0438\u043b\u0438 \u0433\u043e\u043b\u0435\u043c\u0438 \u0434\u0432\u043e\u0440\u043e\u0432\u0435, \u043a\u043e\u0438\u0442\u043e \u0438\u0437\u0432\u044a\u0440\u0448\u0432\u0430\u0442 \u0440\u0435\u0434\u043e\u0432\u043d\u0430 \u0440\u0430\u0431\u043e\u0442\u0430 \u0441 \u0434\u044a\u0440\u0432\u0435\u0441\u0438\u043d\u0430.&lt;/li&gt;\r\n    &lt;li&gt;\u041f\u043e\u0442\u0440\u0435\u0431\u0438\u0442\u0435\u043b\u0438, \u043a\u043e\u0438\u0442\u043e \u0446\u0435\u043d\u044f\u0442 \u043b\u0435\u0441\u043d\u0430 \u043f\u043e\u0434\u0434\u0440\u044a\u0436\u043a\u0430, \u0432\u044a\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442 \u0437\u0430 \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0430 \u0438 \u043d\u0430\u043b\u0438\u0447\u0438\u0435\u0442\u043e \u043d\u0430 \u0444\u0443\u043d\u043a\u0446\u0438\u0438, \u043a\u043e\u0438\u0442\u043e \u0443\u0434\u044a\u043b\u0436\u0430\u0432\u0430\u0442\r\n      \u0436\u0438\u0432\u043e\u0442\u0430 \u043d\u0430 \u0443\u0440\u0435\u0434\u0430 (\u043f\u043e-\u0438\u0437\u0434\u0440\u044a\u0436\u043b\u0438\u0432 \u0432\u044a\u0437\u0434\u0443\u0448\u0435\u043d \u0444\u0438\u043b\u0442\u044a\u0440, \u043a\u043e\u043c\u043f\u0435\u043d\u0441\u0430\u0442\u043e\u0440).\r\n    &lt;/li&gt;\r\n    &lt;li&gt;\u041d\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e \u043e\u0442 \u043e\u043f\u0438\u0442\u0430 \u2014 MS 212 C \u0441\u044a\u0447\u0435\u0442\u0430\u0432\u0430 \u0444\u0443\u043d\u043a\u0446\u0438\u0438 \u0437\u0430 \u043f\u043e-\u043b\u0435\u0441\u0435\u043d \u0441\u0442\u0430\u0440\u0442 \u0438 \u0431\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u043e\u0441\u0442, \u043a\u043e\u0435\u0442\u043e \u0443\u043b\u0435\u0441\u043d\u044f\u0432\u0430 \u0438 \u043f\u043e-\u043c\u0430\u043b\u043a\u043e \u043e\u043f\u0438\u0442\u043d\u0438\r\n      \u043f\u043e\u043b\u0437\u0432\u0430\u0442\u0435\u043b\u0438.\r\n    &lt;/li&gt;\r\n  &lt;/ul&gt;\r\n\r\n  &lt;h2 style=&quot;font-size:18px; margin-top:16px;&quot;&gt;&lt;br&gt;&lt;/h2&gt;&lt;h2 style=&quot;font-size:18px; margin-top:16px;&quot;&gt;\u041f\u0440\u0435\u0434\u0438\u043c\u0441\u0442\u0432\u0430 \u043d\u0430 STIHL MS 212 C-BE&lt;/h2&gt;&lt;p style=&quot;font-size: 18px; margin-top: 16px;&quot;&gt;&lt;br&gt;&lt;/p&gt;\r\n  &lt;ul&gt;\r\n    &lt;li&gt;&lt;strong&gt;\u0421\u0438\u043b\u0435\u043d \u0438 \u0438\u043a\u043e\u043d\u043e\u043c\u0438\u0447\u0435\u043d 2-MIX \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b&lt;/strong&gt; \u2014 \u0431\u0430\u043b\u0430\u043d\u0441 \u043c\u0435\u0436\u0434\u0443 \u043c\u043e\u0449\u043d\u043e\u0441\u0442 \u0438 \u043f\u043e-\u043d\u0438\u0441\u043a\u0438 \u0435\u043c\u0438\u0441\u0438\u0438/\u0440\u0430\u0437\u0445\u043e\u0434 \u043d\u0430 \u0433\u043e\u0440\u0438\u0432\u043e.&lt;/li&gt;\r\n    &lt;li&gt;&lt;strong&gt;\u041d\u0438\u0441\u043a\u043e \u043d\u0438\u0432\u043e \u043d\u0430 \u0432\u0438\u0431\u0440\u0430\u0446\u0438\u0438&lt;/strong&gt; \u2014 \u0443\u0434\u043e\u0431\u0441\u0442\u0432\u043e \u043f\u0440\u0438 \u043f\u0440\u043e\u0434\u044a\u043b\u0436\u0438\u0442\u0435\u043b\u043d\u0430 \u0440\u0430\u0431\u043e\u0442\u0430 \u0438 \u043f\u043e-\u043c\u0430\u043b\u043a\u0430 \u0443\u043c\u043e\u0440\u0430 \u0437\u0430 \u043e\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u0430.&lt;/li&gt;\r\n    &lt;li&gt;&lt;strong&gt;\u041a\u043e\u043c\u043f\u0435\u043d\u0441\u0430\u0442\u043e\u0440 \u0438 \u0440\u0435\u0433\u0443\u043b\u0438\u0440\u0430\u043d\u0435 \u043d\u0430 \u043a\u0430\u0440\u0431\u0443\u0440\u0430\u0442\u043e\u0440\u0430&lt;/strong&gt; \u2014 \u0441\u0442\u0430\u0431\u0438\u043b\u043d\u0430 \u0440\u0430\u0431\u043e\u0442\u0430 \u043d\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e \u043e\u0442 \u0443\u0441\u043b\u043e\u0432\u0438\u044f\u0442\u0430 \u0438 \u0432\u0438\u0441\u043e\u0447\u0438\u043d\u0430\u0442\u0430.&lt;/li&gt;\r\n    &lt;li&gt;&lt;strong&gt;\u0414\u044a\u043b\u044a\u0433 \u0441\u0440\u043e\u043a \u043d\u0430 \u0435\u043a\u0441\u043f\u043b\u043e\u0430\u0442\u0430\u0446\u0438\u044f \u043d\u0430 \u0432\u044a\u0437\u0434\u0443\u0448\u043d\u0438\u044f \u0444\u0438\u043b\u0442\u044a\u0440&lt;/strong&gt; \u2014 \u043f\u043e-\u0440\u044f\u0434\u043a\u043e \u043e\u0431\u0441\u043b\u0443\u0436\u0432\u0430\u043d\u0435 \u0438 \u043f\u043e-\u0434\u043e\u0431\u0440\u0430 \u043d\u0430\u0434\u0435\u0436\u0434\u043d\u043e\u0441\u0442 \u043f\u0440\u0438 \u043f\u0440\u0430\u0448\u043d\u0438\r\n      \u0443\u0441\u043b\u043e\u0432\u0438\u044f; \u0432\u044a\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442 \u0437\u0430 \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u043d\u0438 \u0444\u0438\u043b\u0442\u0440\u0438 \u043f\u0440\u0438 \u0441\u043d\u044f\u0433.\r\n    &lt;/li&gt;\r\n    &lt;li&gt;&lt;strong&gt;\u0418\u043d\u0442\u0435\u0433\u0440\u0438\u0440\u0430\u043d\u0438 \u0441\u0435\u0440\u0432\u0438\u0437\u043d\u0438 \u0443\u0434\u043e\u0431\u0441\u0442\u0432\u0430&lt;/strong&gt; \u2014 \u0431\u0443\u043a\u0441\u0430 \u0437\u0430 \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0430, \u043b\u0435\u0441\u0435\u043d \u0434\u043e\u0441\u0442\u044a\u043f \u0437\u0430 \u043e\u0431\u0441\u043b\u0443\u0436\u0432\u0430\u043d\u0435 \u0438 \u0431\u044a\u0440\u0437\u043e \u043e\u043f\u044a\u0432\u0430\u043d\u0435 \u043d\u0430\r\n      \u0432\u0435\u0440\u0438\u0433\u0430\u0442\u0430 (\u0441\u0442\u0440\u0430\u043d\u0438\u0447\u043d\u043e).\r\n    &lt;/li&gt;\r\n    &lt;li&gt;&lt;strong&gt;\u041e\u043f\u0446\u0438\u0438 \u0437\u0430 \u043b\u0435\u0441\u043d\u043e \u0441\u0442\u0430\u0440\u0442\u0438\u0440\u0430\u043d\u0435 \u0438 \u0431\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u043e\u0441\u0442&lt;/strong&gt; \u2014 \u0444\u0443\u043d\u043a\u0446\u0438\u0438, \u043a\u043e\u0438\u0442\u043e \u0443\u043b\u0435\u0441\u043d\u044f\u0432\u0430\u0442 \u0440\u0430\u0431\u