f \u0442\u0440\u0438\u043e\u043d.&lt;/li&gt;\r\n  &lt;/ul&gt;\r\n\r\n  &lt;h2 style=&quot;font-size:18px; margin-top:16px;&quot;&gt;&lt;br&gt;&lt;/h2&gt;&lt;h2 style=&quot;font-size:18px; margin-top:16px;&quot;&gt;\u041a\u043e\u0433\u0430 \u0434\u0430 \u0438\u0437\u0431\u0435\u0440\u0435\u0442\u0435 MS 212 \u0432\u043c\u0435\u0441\u0442\u043e MS 182?&lt;/h2&gt;&lt;p style=&quot;font-size: 18px; margin-top: 16px;&quot;&gt;&lt;br&gt;&lt;/p&gt;\r\n  &lt;p&gt;\r\n    &lt;span style=&quot;font-size: 14px;&quot;&gt;\u0418\u0437\u0431\u0435\u0440\u0435\u0442\u0435 &lt;/span&gt;&lt;strong&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;MS 212&lt;/span&gt;&lt;/strong&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt; \u0430\u043a\u043e \u0438\u043c\u0430\u0442\u0435 \u043f\u043e-\u0433\u043e\u043b\u0435\u043c\u0438 \u043d\u0443\u0436\u0434\u0438 \u043e\u0442 \u043c\u043e\u0449\u043d\u043e\u0441\u0442, \u0438\u0441\u043a\u0430\u0442\u0435 \u043f\u043e-\u0434\u044a\u043b\u044a\u0433 \u0436\u0438\u0432\u043e\u0442 \u043d\u0430 \u0432\u044a\u0437\u0434\u0443\u0448\u043d\u0438\u044f \u0444\u0438\u043b\u0442\u044a\u0440 \u0438 \u0444\u0443\u043d\u043a\u0446\u0438\u044f \u0437\u0430\r\n    \u043a\u043e\u043c\u043f\u0435\u043d\u0441\u0430\u0446\u0438\u044f \u043f\u0440\u0438 \u043f\u0440\u043e\u043c\u044f\u043d\u0430 \u043d\u0430 \u0443\u0441\u043b\u043e\u0432\u0438\u044f\u0442\u0430 \u043d\u0430 \u0440\u0430\u0431\u043e\u0442\u0430. \u0410\u043a\u043e \u043f\u0440\u0438\u043e\u0440\u0438\u0442\u0435\u0442\u044a\u0442 \u0432\u0438 \u0435 \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u043d\u043e \u043d\u0438\u0441\u043a\u043e \u0442\u0435\u0433\u043b\u043e \u0438 \u043b\u0435\u0441\u043d\u0430 \u043c\u0430\u043d\u0435\u0432\u0440\u0435\u043d\u043e\u0441\u0442 \u043f\u0440\u0438\r\n    \u0440\u0435\u0434\u043a\u0438 \u0433\u0440\u0430\u0434\u0438\u043d\u0441\u043a\u0438 \u0437\u0430\u0434\u0430\u0447\u0438, &lt;/span&gt;&lt;strong&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;MS 182&lt;/span&gt;&lt;/strong&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt; \u043e\u0441\u0442\u0430\u0432\u0430 \u043e\u0442\u043b\u0438\u0447\u043d\u0430, \u043f\u043e-\u043b\u0435\u043a\u0430 \u0430\u043b\u0442\u0435\u0440\u043d\u0430\u0442\u0438\u0432\u0430.&lt;/span&gt;&lt;/p&gt;\r\n\r\n  &lt;p style=&quot;margin-top:12px;&quot;&gt;&lt;br&gt;&lt;/p&gt;\r\n\r\n  &lt;h2 style=&quot;font-size:18px; margin-top:16px;&quot;&gt;\u041a\u0440\u0430\u0442\u043a\u043e \u0440\u0435\u0437\u044e\u043c\u0435 \u0438 \u043f\u0440\u0435\u043f\u043e\u0440\u044a\u043a\u0430&lt;/h2&gt;&lt;p style=&quot;font-size: 18px; margin-top: 16px;&quot;&gt;&lt;br&gt;&lt;/p&gt;\r\n  &lt;p&gt;\r\n    &lt;strong&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;STIHL MS 212&lt;/span&gt;&lt;/strong&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt; \u043a\u043e\u043c\u0431\u0438\u043d\u0438\u0440\u0430 \u043c\u043e\u0449\u043d\u043e\u0441\u0442, \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u043d\u0438 \u0441\u0435\u0440\u0432\u0438\u0437\u043d\u0438 \u0440\u0435\u0448\u0435\u043d\u0438\u044f \u0438 \u0443\u0434\u043e\u0431\u0441\u0442\u0432\u043e \u043f\u0440\u0438 \u0435\u043a\u0441\u043f\u043b\u043e\u0430\u0442\u0430\u0446\u0438\u044f. \u0422\u043e\u0432\u0430 \u0433\u043e \u043f\u0440\u0430\u0432\u0438\r\n    \u0438\u0434\u0435\u0430\u043b\u0435\u043d \u0438\u0437\u0431\u043e\u0440 \u0437\u0430 \u043f\u043e\u0442\u0440\u0435\u0431\u0438\u0442\u0435\u043b\u0438, \u043a\u043e\u0438\u0442\u043e \u0442\u044a\u0440\u0441\u044f\u0442 \u043d\u0430\u0434\u0435\u0436\u0434\u0435\u043d \u0442\u0440\u0438\u043e\u043d \u0437\u0430 \u0442\u0435\u0436\u043a\u0438 \u0434\u043e\u043c\u0430\u0448\u043d\u0438 \u0437\u0430\u0434\u0430\u0447\u0438 \u0438 \u0440\u0435\u0434\u043e\u0432\u043d\u0430 \u0443\u043f\u043e\u0442\u0440\u0435\u0431\u0430. \u0410\u043a\u043e \u0436\u0435\u043b\u0430\u0435\u0442\u0435 \u043f\u043e-\u043b\u0435\u043a\u0430\r\n    \u043c\u0430\u0448\u0438\u043d\u0430 \u0437\u0430 \u043f\u