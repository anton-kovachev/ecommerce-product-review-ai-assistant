043d\u0430 \u0432\u0435\u0440\u0438\u0433\u0430\u0442\u0430 &lt;strong&gt;3/8&quot; P&lt;/strong&gt; \u0438 \u0430\u043d\u0442\u0438\u0432\u0438\u0431\u0440\u0430\u0446\u0438\u043e\u043d\u043d\u0430 \u0441\u0438\u0441\u0442\u0435\u043c\u0430. \u0420\u0430\u0437\u043b\u0438\u043a\u0438\u0442\u0435 \u043c\u0435\u0436\u0434\u0443 \u0442\u044f\u0445 \u0441\u0430 \u043e\u0441\u043d\u043e\u0432\u043d\u043e \u0432 \u0434\u043e\u043f\u044a\u043b\u043d\u0438\u0442\u0435\u043b\u043d\u0438\u0442\u0435\r\n    \u0443\u0434\u043e\u0431\u0441\u0442\u0432\u0430 \u0437\u0430 \u0440\u0430\u0431\u043e\u0442\u0430, \u043a\u043e\u0438\u0442\u043e \u0432\u0435\u0440\u0441\u0438\u044f\u0442\u0430 &lt;strong&gt;C-BE&lt;/strong&gt; \u043f\u0440\u0435\u0434\u043b\u0430\u0433\u0430.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;\r\n  &lt;/p&gt;\r\n\r\n  &lt;h2 style=&quot;font-size:18px; margin-top:16px;&quot;&gt;\u041e\u0441\u043d\u043e\u0432\u043d\u0438 \u0440\u0430\u0437\u043b\u0438\u043a\u0438&lt;/h2&gt;&lt;p style=&quot;font-size: 18px; margin-top: 16px;&quot;&gt;&lt;br&gt;&lt;/p&gt;\r\n  &lt;ul&gt;\r\n    &lt;li&gt;&lt;strong&gt;\u0421\u0438\u0441\u0442\u0435\u043c\u0430 \u0437\u0430 \u0431\u044a\u0440\u0437\u043e \u043e\u043f\u044a\u0432\u0430\u043d\u0435 \u043d\u0430 \u0432\u0435\u0440\u0438\u0433\u0430\u0442\u0430 (B \u2014 Quick Chain Tensioning)&lt;/strong&gt;  \r\n      \u041f\u0440\u0438 &lt;strong&gt;MS 212 C-BE&lt;/strong&gt; \u0432\u0435\u0440\u0438\u0433\u0430\u0442\u0430 \u043c\u043e\u0436\u0435 \u0434\u0430 \u0431\u044a\u0434\u0435 \u043e\u043f\u044a\u043d\u0430\u0442\u0430 \u0431\u0435\u0437 \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0438 \u0447\u0440\u0435\u0437 \u0441\u0442\u0440\u0430\u043d\u0438\u0447\u043d\u043e \u043a\u043e\u043b\u0435\u043b\u043e. \u0422\u043e\u0432\u0430 \u0443\u043b\u0435\u0441\u043d\u044f\u0432\u0430\r\n      \u0438 \u0443\u0441\u043a\u043e\u0440\u044f\u0432\u0430 \u043e\u0431\u0441\u043b\u0443\u0436\u0432\u0430\u043d\u0435\u0442\u043e, \u043e\u0441\u043e\u0431\u0435\u043d\u043e \u043f\u0440\u0438 \u0447\u0435\u0441\u0442\u0430 \u0441\u043c\u044f\u043d\u0430 \u0438\u043b\u0438 \u0440\u0435\u0433\u0443\u043b\u0438\u0440\u0430\u043d\u0435 \u043d\u0430 \u0432\u0435\u0440\u0438\u0433\u0430\u0442\u0430.  \r\n      \u041f\u0440\u0438 \u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043d\u0438\u044f &lt;strong&gt;MS 212&lt;/strong&gt; \u043e\u043f\u044a\u0432\u0430\u043d\u0435\u0442\u043e \u0441\u0442\u0430\u0432\u0430 \u0441 \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442 (\u043a\u043b\u044e\u0447/\u043e\u0442\u0432\u0435\u0440\u0442\u043a\u0430).\r\n    &lt;/li&gt;\r\n\r\n    &lt;li&gt;&lt;strong&gt;\u0421\u0438\u0441\u0442\u0435\u043c\u0430 \u0437\u0430 \u043b\u0435\u0441\u043d\u043e \u0441\u0442\u0430\u0440\u0442\u0438\u0440\u0430\u043d\u0435 (E \u2014 Easy2Start)&lt;/strong&gt;  \r\n      &lt;strong&gt;MS 212 C-BE&lt;/strong&gt; \u0435 \u043e\u0431\u043e\u0440\u0443\u0434\u0432\u0430\u043d \u0441\u044a\u0441 \u0441\u0438\u0441\u0442\u0435\u043c\u0430 \u0437\u0430 \u043e\u0431\u043b\u0435\u043a\u0447\u0435\u043d \u0441\u0442\u0430\u0440\u0442, \u043a\u043e\u044f\u0442\u043e \u043d\u0430\u043c\u0430\u043b\u044f\u0432\u0430 \u0443\u0441\u0438\u043b\u0438\u0435\u0442\u043e \u043f\u0440\u0438 \u0434\u044a\u0440\u043f\u0430\u043d\u0435 \u043d\u0430 \u0441\u0442\u0430\u0440\u0442\u0435\u0440\u043d\u043e\u0442\u043e \u0432\u044a\u0436\u0435\r\n      \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u0435\u043d\u0438\u0435 \u043d\u0430 \u043f\u0440\u0443\u0436\u0438\u043d\u0435\u043d \u043c\u0435\u0445\u0430\u043d\u0438\u0437\u044a\u043c.  \r\n      \u041f\u0440\u0438 \u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043d\u0438\u044f &lt;strong&gt;MS 212&lt;/strong&gt; \u0441\u0435 \u0438\u0437\u043f\u043e\u043b\u0437\u0432\u0430 \u0442\u0440\u0430\u0434\u0438\u0446\u0438\u043e\u043d\u0435\u043d \u0441\u0442\u0430\u0440\u0442\u0435\u0440, \u043a\u043e\u0439\u0442\u043e \u0438\u0437\u04