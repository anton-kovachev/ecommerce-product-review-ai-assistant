\u0442\u0438\u0432\u0438\u0431\u0440\u0430\u0446\u0438\u043e\u043d\u043d\u0430 \u0441\u0438\u0441\u0442\u0435\u043c\u0430&lt;/b&gt;: \u041d\u0430\u043c\u0430\u043b\u044f\u0432\u0430 \u0432\u0438\u0431\u0440\u0430\u0446\u0438\u0438\u0442\u0435, \u043f\u0440\u0435\u0434\u0430\u0432\u0430\u043d\u0438 \u043a\u044a\u043c \u0440\u044a\u043a\u043e\u0445\u0432\u0430\u0442\u043a\u0430\u0442\u0430, \u043a\u043e\u0435\u0442\u043e \u043e\u0441\u0438\u0433\u0443\u0440\u044f\u0432\u0430 \u043f\u043e-\u0433\u043e\u043b\u044f\u043c \u043a\u043e\u043c\u0444\u043e\u0440\u0442 \u043f\u0440\u0438 \u043f\u0440\u043e\u0434\u044a\u043b\u0436\u0438\u0442\u0435\u043b\u043d\u0430 \u0440\u0430\u0431\u043e\u0442\u0430 \u0438 \u043f\u043e-\u043c\u0430\u043b\u043a\u043e \u0443\u043c\u043e\u0440\u0430.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;4&lt;b&gt;-\u043a\u0430\u043d\u0430\u043b\u043d\u0430 \u0442\u0435\u0445\u043d\u043e\u043b\u043e\u0433\u0438\u044f \u043d\u0430 STIHL&lt;/b&gt;: \u041f\u043e\u0434\u043e\u0431\u0440\u044f\u0432\u0430 \u0435\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0442\u0430 \u043d\u0430 \u0433\u043e\u0440\u0438\u0432\u043e\u0442\u043e \u0447\u0440\u0435\u0437 \u043e\u043f\u0442\u0438\u043c\u0430\u043b\u043d\u043e \u0438\u0437\u0433\u0430\u0440\u044f\u043d\u0435 \u043d\u0430 \u0441\u043c\u0435\u0441\u0442\u0430 \u0432\u044a\u0437\u0434\u0443\u0445-\u0433\u043e\u0440\u0438\u0432\u043e, \u043a\u043e\u0435\u0442\u043e \u0432\u043e\u0434\u0438 \u0434\u043e \u043f\u043e-\u0432\u0438\u0441\u043e\u043a\u0430 \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0438\u0442\u0435\u043b\u043d\u043e\u0441\u0442 \u0438 \u043f\u043e-\u043d\u0438\u0441\u044a\u043a \u0440\u0430\u0437\u0445\u043e\u0434 \u043d\u0430 \u0433\u043e\u0440\u0438\u0432\u043e.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;\u041f\u0440\u043e\u0437\u0440\u0430\u0447\u0435\u043d \u0440\u0435\u0437\u0435\u0440\u0432\u043e\u0430\u0440 \u0437\u0430 \u043c\u0430\u0441\u043b\u043e&lt;/b&gt;: \u0423\u043b\u0435\u0441\u043d\u044f\u0432\u0430 \u043d\u0430\u0431\u043b\u044e\u0434\u0435\u043d\u0438\u0435\u0442\u043e \u043d\u0430 \u043d\u0438\u0432\u043e\u0442\u043e \u043d\u0430 \u043c\u0430\u0441\u043b\u043e\u0442\u043e, \u043a\u043e\u0435\u0442\u043e \u0432\u0438 \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u0432\u0430 \u0434\u0430 \u0440\u0430\u0431\u043e\u0442\u0438\u0442\u0435 \u043f\u043e-\u0434\u044a\u043b\u0433\u043e \u0431\u0435\u0437 \u043f\u0440\u0435\u043a\u044a\u0441\u0432\u0430\u043d\u0438\u044f.&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;h3&gt;\u041f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u044f&lt;span style=&quot;font-size: 14px;&quot;&gt;:&lt;/span&gt;&lt;/h3&gt;&lt;p&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;\u041f\u043e\u0434\u0434\u0440\u044a\u0436\u043a\u0430 \u043d\u0430 \u0433\u0440\u0430\u0434\u0438\u043d\u0438 \u0438 \u0434\u0432\u043e\u0440\u043e\u0432\u0435&lt;/b&gt;: \u0418\u0434\u0435\u0430\u043b\u0435\u043d \u0437\u0430 \u043f\u043e\u0434\u0440\u044f\u0437\u0432\u0430\u043d\u0435 \u043d\u0430 \u0434\u044a\u0440\u0432\u0435\u0442\u0430, \u043a\u043b\u043e\u043d\u0438 \u0438 \u043c\u0430\u043b\u043a\u0438 \u0434\u044a\u0440\u0432\u0435\u0441\u043d\u0438 \u0441\u0442\u0432\u043e\u043b\u043e\u0432\u0435.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;\u0420\u044f\u0437\u0430\u043d\u0435 \u043d\u0430 \u0434\u044a\u0440\u0432\u0430 \u0437\u0430 \u043e\u0433\u0440\u0435\u0432&lt;/b&gt;: \u041f\u043e\u0434\u0445\u043e\u0434\u044f\u0449 \u0437\u0430 \u0440\u044f\u0437\u0430\u043d\u0435 \u043d\u0430 \u043c\u0430\u043b\u043a\u0438 \u0434\u043e \u0441\u0440\u0435\u0434\u043d\u043e \u0433\u043e\u043b\u0435\u043c\u0438 \u0434\u044a\u0440\u0432\u0435\u0442\u0430 \u0437\u0430 \u043e\u0433\u0440\u0435\u0432.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;\u041b\u0435\u043a\u0438 \u0441\u0442\u0440\u043e\u0438\u0442\u0435\u043b\u043d\u0438 \u0437\u0430\u0434\u0430\u0447\u0438&lt;/b&gt;: \u041c\u043e\u0436\u0435 \u0434\u0430 \u0441\u0435 \u0438\u0437\u043f\u043e\u043b\u0437\u0432\u0430 \u0437\u0430 \u0440\u044f\u0437\u0430\u043d\u0435 \u043d\u0430 \u0434\u044a\u0440\u0432\u0435\u043d \u043c\u0430\u0442\u0435\u0440\u0438\u0430\u043b \u043f\u0440\u0438 \u0440\u0430\u0437\u043b\u0438\u0447\u043d\u0438 \u0434\u043e\u043c\u0430\u0448\u043d\u0438 \u0441\u0442\u0440\u043e\u0438\u0442\u0435\u043b\u043d\u0438 \u043f\u0440\u043e\u0435\u043a\u0442\u0438.&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;h3&gt;\u041f\u0440\u0435\u0434\u0438\u043c\u0441\u0442\u0432\u0430&lt;span style=&quot;font-size: 14px;&quot;&gt;:&lt;/span&gt;&lt;/h3&gt;&lt;p&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;\u041b\u0435\u043a \u0438&lt;/b&gt; &lt;b&gt;\u043a\u043e\u043c\u043f\u0430\u043a\u0442\u0435\u043d: \u041b\u0435\u0441\u0435\u043d \u0437\u0430 \u043c\u0430\u043d\u0435\u0432\u0440\u0438\u0440\u0430\u043d\u0435 \u0438 \u0443\u0434\u043e\u0431\u0435\u043d \u0437\u0430 \u043f\u0440\u043e\u0434\u044a\u043b\u0436\u0438\u0442\u0435\u043b\u043d\u0430 \u0443\u043f\u043e\u0442\u0440\u0435\u0431\u0430.&lt;/b&gt;&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;\u041c\u043e\u0449\u043d\u043e\u0441\u0442&lt;/b&gt; \u0437\u0430 \u0435\u0436\u0435\u0434\u043d\u0435\u0432\u043d\u0438 \u0437\u0430\u0434\u0430\u0447\u0438: \u0421 1,9 \u043a.\u0441., \u0442\u0440\u0438\u043e\u043d\u044a\u0442 \u0435 \u0434\u043e\u0441\u0442\u0430\u0442\u044a\u0447\u043d\u043e \u043c\u043e\u0449\u0435\u043d \u0437\u0430 \u0448\u0438\u0440\u043e\u043a \u0441\u043f\u0435\u043a\u0442\u044a\u0440 \u043e\u0442 \u0434\u043e\u043c\u0430\u0448\u043d\u0438 \u0437\u0430\u0434\u0430\u0447\u0438.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;\u0418\u043a\u043e\u043d\u043e\u043c\u0438\u0447\u0435\u043d \u0438 \u0435\u0444\u0435\u043a\u0442\u0438\u0432\u0435\u043d&lt;/b&gt;: \u0414\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044f\u0442 2-Mix \u043d\u0430\u043c\u0430\u043b\u044f\u0432\u0430 \u0440\u0430\u0437\u0445\u043e\u0434\u0430 \u043d\u0430 \u0433\u043e\u0440\u0438\u0432\u043e \u0438 \u0435\u043c\u0438\u0441\u0438\u0438\u0442\u0435, \u043a\u043e\u0435\u0442\u043e \u0433\u043e \u043f\u0440\u0430\u0432\u0438 \u043f\u043e-\u0435\u043a\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u043d.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;\u041d\u0438\u0441\u043a\u043e \u043d\u0438\u0432\u043e \u043d\u0430 \u0432\u0438\u0431\u0440\u0430\u0446\u0438\u0438&lt;/b&gt;: \u0410\u043d\u0442\u0438\u0432\u0438\u0431\u0440\u0430\u0446\u0438\u043e\u043d\u043d\u0430\u0442\u0430 \u0441\u0438\u0441\u0442\u0435\u043c\u0430 \u043f\u043e\u0434\u043e\u0431\u0440\u044f\u0432\u0430 \u043a\u043e\u043c\u0444\u043e\u0440\u0442\u0430 \u0438 \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u0432\u0430 \u043f\u043e-\u0434\u044a\u043b\u0433\u0430 \u0440\u0430\u0431\u043e\u0442\u0430 \u0431\u0435\u0437 \u0443\u043c\u043e\u0440\u0430.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;\u041b\u0435\u0441\u043d\u0430 \u043f\u043e\u0434\u0434\u0440\u044a\u0436\u043a\u0430 \u0438 \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435&lt;/b&gt;: \u0421\u0442\u0440\u0430\u043d\u0438\u0447\u043d\u043e\u0442\u043e \u043e\u043f\u044a\u0432\u0430\u043d\u0435 \u043d\u0430 \u0432\u0435\u0440\u0438\u0433\u0430\u0442\u0430 \u0438 \u043f\u0440\u043e\u0437\u0440\u0430\u0447\u043d\u0438\u044f\u0442 \u0440\u0435\u0437\u0435\u0440\u0432\u043e\u0430\u0440 \u0437\u0430 \u043c\u0430\u0441\u043b\u043e \u0443\u043b\u0435\u0441\u043d\u044f\u0432\u0430\u0442 \u043f\u043e\u0434\u0434\u0440\u044a\u0436\u043a\u0430\u0442\u0430 \u043d\u0430 \u0442\u0440\u0438\u043e\u043d\u0430.&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;h2&gt;\u0417\u0430\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0435&lt;span style=&quot;font-size: 14px;&quot;&gt;:&lt;/span&gt;&lt;/h2&gt;&lt;p&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;STIHL MS 172 \u0435 \u043e\u0442\u043b\u0438\u0447\u0435\u043d \u0438\u0437\u0431\u043e\u0440 \u0437\u0430 \u0434\u043e\u043c\u0430\u0448\u043d\u0430 \u0443\u043f\u043e\u0442\u0440\u0435\u0431\u0430 \u0438 \u043f\u043e\u0434\u0434\u0440\u044a\u0436\u043a\u0430 \u043d\u0430 \u0433\u0440\u0430\u0434\u0438\u043d\u0438. \u041b\u0435\u043a, \u0443\u0434\u043e\u0431\u0435\u043d \u0438 \u0438\u043a\u043e\u043d\u043e\u043c\u0438\u0447\u0435\u043d, \u0442\u043e\u0439 \u043f\u0440\u0435\u0434\u043b\u0430\u0433\u0430 \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u0430\u0442\u0430 \u043c\u043e\u0449\u043d\u043e\u0441\u0442 \u0438 \u0444\u0443\u043d\u043a\u0446\u0438\u043e\u043d\u0430\u043b\u043d\u043e\u0441\u0442\u0438 \u0437\u0430 \u0440\u044f\u0437\u0430\u043d\u0435 \u043d\u0430 \u0434\u044a\u0440\u0432\u0430 \u0438 \u043f\u043e\u0434\u0434\u0440\u044a\u0436\u043a\u0430 \u043d\u0430 \u043c\u0430\u043b\u043a\u0438 \u0434\u044a\u0440\u0432\u0435\u0442\u0430 \u0438 \u043a\u043b\u043e\u043d\u0438. \u0410\u043d\u0442\u0438\u0432\u0438\u0431\u0440\u0430\u0446\u0438\u043e\u043d\u043d\u0430\u0442\u0430 \u0441\u0438\u0441\u0442\u0435\u043c\u0430 \u0438 \u0438\u043a\u043e\u043d\u043e\u043c\u0438\u0447\u043d\u0438\u044f\u0442 \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b \u0433\u043e \u043f\u0440\u0430\u04