8\u0437\u0432\u044a\u0440\u0448\u0432\u0430\u0442 \u0440\u0435\u043c\u043e\u043d\u0442\u0438\u0442\u0435&lt;/li&gt;\r\n&lt;/ul&gt;\r\n\r\n&lt;h2&gt;&lt;br&gt;&lt;/h2&gt;&lt;h2&gt;\u041f\u0440\u0435\u043f\u043e\u0440\u044a\u043a\u0438 \u0437\u0430 \u043f\u043e\u0434\u0434\u0440\u044a\u0436\u043a\u0430 \u0438 \u0438\u043d\u0441\u0442\u0430\u043b\u0430\u0446\u0438\u044f&lt;/h2&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;\r\n\r\n&lt;ul&gt;\r\n  &lt;li&gt;&lt;strong&gt;\u041f\u0440\u043e\u0444\u0435\u0441\u0438\u043e\u043d\u0430\u043b\u0435\u043d \u043c\u043e\u043d\u0442\u0430\u0436:&lt;/strong&gt; \u043f\u0440\u0435\u043f\u043e\u0440\u044a\u0447\u0432\u0430 \u0441\u0435 \u0438\u043d\u0441\u0442\u0430\u043b\u0430\u0446\u0438\u044f\u0442\u0430 \u0434\u0430 \u0431\u044a\u0434\u0435 \u0438\u0437\u0432\u044a\u0440\u0448\u0435\u043d\u0430 \u043e\u0442 \u043a\u0432\u0430\u043b\u0438\u0444\u0438\u0446\u0438\u0440\u0430\u043d \u0442\u0435\u0445\u043d\u0438\u043a&lt;/li&gt;\r\n  &lt;li&gt;&lt;strong&gt;\u0420\u0435\u0434\u043e\u0432\u043d\u0430 \u043f\u043e\u0434\u0434\u0440\u044a\u0436\u043a\u0430:&lt;/strong&gt; \u043f\u0435\u0440\u0438\u043e\u0434\u0438\u0447\u043d\u0430\u0442\u0430 \u043f\u0440\u043e\u0432\u0435\u0440\u043a\u0430 \u0438 \u043f\u043e\u0447\u0438\u0441\u0442\u0432\u0430\u043d\u0435 \u043d\u0430 \u0446\u0438\u043b\u0438\u043d\u0434\u044a\u0440\u0430 \u0438 \u0431\u0443\u0442\u0430\u043b\u043e\u0442\u043e \u0443\u0434\u044a\u043b\u0436\u0430\u0432\u0430 \u0436\u0438\u0432\u043e\u0442\u0430 \u043d\u0430 \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044f&lt;/li&gt;\r\n  &lt;li&gt;&lt;strong&gt;\u0418\u0437\u043f\u043e\u043b\u0437\u0432\u0430\u043d\u0435 \u043d\u0430 \u043e\u0440\u0438\u0433\u0438\u043d\u0430\u043b\u043d\u0438 \u0447\u0430\u0441\u0442\u0438:&lt;/strong&gt; \u0433\u0430\u0440\u0430\u043d\u0442\u0438\u0440\u0430 \u0441\u044a\u0432\u043c\u0435\u0441\u0442\u0438\u043c\u043e\u0441\u0442 \u0438 \u043e\u043f\u0442\u0438\u043c\u0430\u043b\u043d\u0430 \u0440\u0430\u0431\u043e\u0442\u0430 \u043d\u0430 \u0442\u0440\u0438\u043e\u043d\u0430&lt;/li&gt;\r\n&lt;/ul&gt;\r\n\r\n&lt;h2&gt;&lt;br&gt;&lt;/h2&gt;&lt;h2&gt;\u0417\u0430\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0435&lt;/h2&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;\r\n\r\n&lt;p&gt;\u041f\u043e\u0434\u0434\u044a\u0440\u0436\u0430\u043d\u0435\u0442\u043e \u043d\u0430 \u0432\u0430\u0448\u0438\u044f &lt;strong&gt;\u043c\u043e\u0442\u043e\u0440\u0435\u043d \u0442\u0440\u0438\u043e\u043d STIHL MS 172, MS 172 C&lt;/strong&gt;&amp;nbsp;\u0432 \u043e\u0442\u043b\u0438\u0447\u043d\u043e \u0441\u044a\u0441\u0442\u043e\u044f\u043d\u0438\u0435 \u0438\u0437\u0438\u0441\u043a\u0432\u0430 \u0438\u0437\u043f\u043e\u043b\u0437\u0432\u0430\u043d\u0435\u0442\u043e \u043d\u0430 \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435\u043d\u0438 \u0440\u0435\u0437\u0435\u0440\u0432\u043d\u0438 \u0447\u0430\u0441\u0442\u0438. &lt;strong&gt;\u041a\u043e\u043c\u043f\u043b\u0435\u043a\u0442\u044a\u0442 \u0446\u0438\u043b\u0438\u043d\u0434\u044a\u0440 \u0438 \u0431\u0443\u0442\u0430\u043b\u043e \u00d8 38 mm (\u0440\u0435\u0437\u0435\u0440\u0432\u043d\u0430 \u0447\u0430\u0441\u0442 1148 0201 203)&lt;/strong&gt; \u043e\u0441\u0438\u0433\u0443\u0440\u044f\u0432\u0430 \u043d\u0430\u0434\u0435\u0436\u0434\u043d\u0430 \u0438 \u0435\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u0430 \u0440\u0430\u0431\u043e\u0442\u0430 \u043d\u0430 \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044f, \u0443\u0434\u044a\u043b\u0436\u0430\u0432\u0430\u0439\u043a\u0438 \u0436\u0438\u0432\u043e\u0442\u0430 \u043d\u0430 \u0432\u0430\u0448\u0438\u044f \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442 \u0438 \u0433\u0430\u0440\u0430\u043d\u0442\u0438\u0440\u0430\u0439\u043a\u0438 \u0432\u0438\u0441\u043e\u043a\u0430 \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0438\u0442\u0435\u043b\u043d\u043e\u0441\u0442 \u043f\u0440\u0438 \u0432\u0441\u044f\u043a\u0430 \u0443\u043f\u043e\u0442\u0440\u0435\u0431\u0430.&lt;/p&gt;\r\n\r\n&lt;/div&gt;&lt;br&gt;"}]