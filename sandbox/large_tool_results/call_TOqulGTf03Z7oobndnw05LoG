u0442 \u043e\u0442 \u0441\u0440\u0435\u0434\u043d\u0438 \u043a\u043b\u0430\u0441 \u043c\u043e\u0442\u043e\u0440\u043d\u043a\u0438 \u043a\u043e\u0441\u0430\u0447\u043a\u0438 \u043d\u0430 \u0412\u0438\u043a\u0438\u043d\u0433, \u0444\u0438\u0440\u043c\u0430 \u043d\u0430 \u0429\u0438\u043b, \u0437\u0430 \u0435\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e \u043a\u043e\u0441\u0435\u043d\u0435 \u043d\u0430 \u0442\u0440\u0435\u0432\u0430 \u043d\u0430 \u0441\u0440\u0435\u0434\u043d\u043e\u0433\u043e\u043b\u0435\u043c\u0438 \u043f\u043b\u043e\u0449\u0438. \u0422\u044f \u0435 \u0447\u0430\u0441\u0442 \u043e\u0442 \u0441\u0435\u0440\u0438\u044f\u0442\u0430 \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435\u043d\u0438 \u043a\u043e\u0441\u0430\u0447\u043a\u0438 \u0437\u0430 \u0441\u0440\u0435\u0434\u043d\u043e \u0433\u043e\u043b\u0435\u043c\u0438 \u0442\u0440\u0435\u0432\u043d\u0438 \u043f\u043b\u043e\u0449\u0438 \u043d\u0430 \u0430\u0442\u0440\u0430\u043a\u0442\u0438\u0432\u043d\u0438 \u0446\u0435\u043d\u0438 \u043e\u0442 \u0429\u0438\u043b.&lt;/span&gt;&lt;/p&gt;&lt;h2&gt;&lt;br&gt;\u041a\u0430\u043a\u0432\u043e \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u044f\u0432\u0430 \u0431\u0435\u043d\u0437\u0438\u043d\u043e\u0432\u0430\u0442\u0430 \u043a\u043e\u0441\u0430\u0447\u043a\u0430 STIHL RM 253?&lt;/h2&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;\u0411\u0435\u043d\u0437\u0438\u043d\u043e\u0432\u0430\u0442\u0430 \u043a\u043e\u0441\u0430\u0447\u043a\u0430 STIHL RM 253 \u0435 \u0432\u0438\u0441\u043e\u043a\u043e\u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435\u043d \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442, \u043f\u0440\u0435\u0434\u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d \u0437\u0430 \u0435\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e \u0438 \u0443\u0434\u043e\u0431\u043d\u043e \u043a\u043e\u0441\u0435\u043d\u0435 \u043d\u0430 \u0442\u0440\u0435\u0432\u043d\u0438 \u043f\u043b\u043e\u0449\u0438. \u0415\u0442\u043e \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u0430 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044f \u0437\u0430 \u043d\u0435\u0439\u043d\u0438\u0442\u0435 \u043e\u0441\u043d\u043e\u0432\u043d\u0438 \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043a\u0438:&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;li style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;\u041a\u043e\u0440\u043f\u0443\u0441: &lt;/b&gt;\u041c\u0435\u0442\u0430\u043b\u0435\u043d - \u041c\u0435\u0442\u0430\u043b\u043d\u0438\u044f\u0442 \u043a\u043e\u0440\u043f\u0443\u0441 \u043d\u0430 \u043a\u043e\u0441\u0430\u0447\u043a\u0430\u0442\u0430 \u043e\u0441\u0438\u0433\u0443\u0440\u044f\u0432\u0430 \u0437\u0434\u0440\u0430\u0432\u0438\u043d\u0430 \u0438 \u0434\u044a\u043b\u0433\u043e\u0442\u0440\u0430\u0439\u043d\u043e\u0441\u0442, \u043f\u0440\u0435\u0434\u043f\u0430\u0437\u0432\u0430\u0439\u043a\u0438 \u0432\u044a\u0442\u0440\u0435\u0448\u043d\u0438\u0442\u0435 \u043a\u043e\u043c\u043f\u043e\u043d\u0435\u043d\u0442\u0438 \u0438 \u0443\u0434\u044a\u043b\u0436\u0430\u0432\u0430\u0439\u043a\u0438 \u0435\u043a\u0441\u043f\u043b\u043e\u0430\u0442\u0430\u0446\u0438\u043e\u043d\u043d\u0438\u044f \u0439 \u0436\u0438\u0432\u043e\u0442.&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;\u0428\u0438\u0440\u0438\u043d\u0430 \u043d\u0430 \u043a\u043e\u0441\u0435\u043d\u0435&lt;/b&gt;: 51 \u0441\u043c - \u0422\u0430\u0437\u0438 \u0448\u0438\u0440\u0438\u043d\u0430 \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u0432\u0430 \u0431\u044a\u0440\u0437\u043e \u0438 \u0435\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e \u043a\u043e\u0441\u0435\u043d\u0435 \u043d\u0430 \u0433\u043e\u043b\u0435\u043c\u0438 \u043f\u043b\u043e\u0449\u0438, \u043f\u043e\u043a\u0440\u0438\u0432\u0430\u0439\u043a\u0438 \u0437\u043d\u0430\u0447\u0438\u0442\u0