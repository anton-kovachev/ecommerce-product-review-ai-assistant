0435 \u043f\u0440\u043e\u0435\u043a\u0442\u0438\u0440\u0430\u043d\u0430 \u0437\u0430 \u0443\u0434\u043e\u0431\u0441\u0442\u0432\u043e \u0438 \u0432\u0438\u0441\u043e\u043a\u0430 \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0438\u0442\u0435\u043b\u043d\u043e\u0441\u0442, \u043a\u0430\u0442\u043e \u0441\u044a\u0447\u0435\u0442\u0430\u0432\u0430 \u043c\u043e\u0449\u043d\u043e\u0441\u0442 \u0438 \u0435\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442 \u0441 \u043b\u0435\u043a\u043e\u0442\u0430 \u043d\u0430 \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u0435\u043d\u0438\u0435 \u043d\u0430 \u0441\u0430\u043c\u043e\u0445\u043e\u0434\u043d\u0430\u0442\u0430 \u0441\u0438 \u0444\u0443\u043d\u043a\u0446\u0438\u044f. \u0422\u0430\u0437\u0438 \u043a\u043e\u0441\u0430\u0447\u043a\u0430 \u0435 \u0438\u0434\u0435\u0430\u043b\u0435\u043d \u0438\u0437\u0431\u043e\u0440 \u0437\u0430 \u043f\u043e\u0442\u0440\u0435\u0431\u0438\u0442\u0435\u043b\u0438, \u043a\u043e\u0438\u0442\u043e \u0441\u0435 \u043d\u0443\u0436\u0434\u0430\u044f\u0442 \u043e\u0442 \u043d\u0430\u0434\u0435\u0436\u0434\u043d\u043e \u0438 \u0435\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e \u0440\u0435\u0448\u0435\u043d\u0438\u0435 \u0437\u0430 \u043f\u043e\u0434\u0434\u0440\u044a\u0436\u043a\u0430 \u043d\u0430 \u0441\u0432\u043e\u0438\u0442\u0435 \u0442\u0440\u0435\u0432\u043d\u0438 \u043f\u043b\u043e\u0449\u0438.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;h2&gt;\u041a\u0430\u043a\u0432\u0430 \u0435 \u0440\u0430\u0437\u043b\u0438\u043a\u0430\u0442\u0430 \u043c\u0435\u0436\u0434\u0443 \u0431\u0435\u043d\u0437\u0438\u043d\u043e\u0432\u0430 \u043a\u043e\u0441\u0430\u0447\u043a\u0430 \u0437\u0430 \u0442\u0440\u0435\u0432\u0430 STIHL RM 253 T \u0438 RM 253?&lt;/h2&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;\u0411\u0435\u043d\u0437\u0438\u043d\u043e\u0432\u0438\u0442\u0435 \u043a\u043e\u0441\u0430\u0447\u043a\u0438 \u0437\u0430 \u0442\u0440\u0435\u0432\u0430 STIHL RM 253 \u0438 RM 253 T \u0441\u0430 \u0434\u0432\u0430 \u043c\u043e\u0434\u0435\u043b\u0430 \u043e\u0442 \u043f\u043e\u0440\u0442\u0444\u043e\u043b\u0438\u043e\u0442\u043e \u043d\u0430 STIHL, \u043a\u0430\u0442\u043e \u0438 \u0434\u0432\u0430\u0442\u0430 \u043f\u0440\u0435\u0434\u043b\u0430\u0433\u0430\u0442 \u0432\u0438\u0441\u043e\u043a\u043e\u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435\u043d\u043e \u043a\u043e\u0441\u0435\u043d\u0435 \u043d\u0430 \u0442\u0440\u0435\u0432\u043d\u0438 \u043f\u043b\u043e\u0449\u0438. \u0420\u0430\u0437\u043b\u0438\u043a\u0438\u0442\u0435 \u043c\u0435\u0436\u0434\u0443 \u0442\u0435\u0437\u0438 \u0434\u0432\u0430 \u043c\u043e\u0434\u0435\u043b\u0430 \u043e\u0431\u0438\u043a\u043d\u043e\u0432\u0435\u043d\u043e \u0441\u0435 \u0444\u043e\u043a\u0443\u0441\u0438\u0440\u0430\u0442 \u0432\u044a\u0440\u0445\u0443 \u0441\u043f\u0435\u0446\u0438\u0444\u0438\u0447\u043d\u0438 \u0444\u0443\u043d\u043a\u0446\u0438\u0438 \u0438 \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043a\u0438, \u043a\u043e\u0438\u0442\u043e \u0430\u0434\u0440\u0435\u0441\u0438\u0440\u0430\u0442 \u0440\u0430\u0437\u043b\u0438\u0447\u043d\u0438 \u043d\u0443\u0436\u0434\u0438 \u0438 \u043f\u0440\u0435\u0434\u043f\u043e\u0447\u0438\u0442\u0430\u043d\u0438\u044f \u043d\u0430 \u043f\u043e\u0442\u0440\u0435\u0431\u0438\u0442\u0435\u043b\u0438\u0442\u0435. \u0415\u0442\u043e \u043d\u044f\u043a\u043e\u0438 \u043e\u0442 \u043e\u0441\u043d\u043e\u0432\u043d\u0438\u0442\u0435 \u0440\u0430\u0437\u043b\u0438\u043a\u0438:&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;ul&gt;&lt;li style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;\u0421\u0430\u043c\u043e\u0445\u043e\u0434\u043d\u0430 \u0441\u0438\u0441\u0442\u0435\u043c\u0430 (\u0421\u0430\u043c\u043e\u0445\u043e\u0434):&lt;/b&gt; \u041e\u0441\u043d\u043e\u0432\u043d\u0430\u0442\u0430 \u0440\u0430\u0437\u043b\u0438\u043a\u0430 \u043c\u0435\u0436\u0434\u0443 RM 253 \u0438 RM 253 T \u0447\u0435\u0441\u0442\u043e \u0435 \u0432 \u0441\u0430\u043c\u043e\u0445\u043e\u0434\u043d\u0430\u0442\u0430 \u0441\u0438\u0441\u0442\u0435\u043c\u0430. \u041c\u043e\u0434\u0435\u043b\u044a\u0442 RM 253 T \u043e\u0431\u0438\u043a\u043d\u043e\u0432\u0435\u043d\u043e \u0435 \u043e\u0431\u043e\u0440\u0443\u0434\u0432\u0430\u043d \u0441\u044a\u0441 \u0441\u0430\u043c\u043e\u0445\u043e\u0434\u043d\u0430 \u0441\u0438\u0441\u0442\u0435\u043c\u0430 (T \u043e\u0437\u043d\u0430\u0447\u0430\u0432\u0430 \u0442\u044f\u0433\u0430), \u043a\u043e\u0435\u0442\u043e \u043e\u0437\u043d\u0430\u0447\u0430\u0432\u0430, \u0447\u0435 \u043a\u043e\u0441\u0430\u0447\u043a\u0430\u0442\u0430 \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u043d\u043e \u0441\u0435 \u0434\u0432\u0438\u0436\u0438 \u043d\u0430\u043f\u0440\u0435\u0434, \u043a\u043e\u0433\u0430\u0442\u043e \u0435 \u0430\u043a\u0442\u0438\u0432\u0438\u0440\u0430\u043d\u0430, \u0443\u043b\u0435\u0441\u043d\u044f\u0432\u0430\u0439\u043a\u0438 \u0440\u0430\u0431\u043e\u0442\u0430\u0442\u0430 \u043d\u0430 \u043f\u043e\u0442\u0440\u0435\u0431\u0438\u0442\u0435\u043b\u044f, \u043e\u0441\u043e\u0431\u0435\u043d\u043e \u043d\u0430 \u043d\u0435\u0440\u0430\u0432\u043d\u0438 \u0442\u0435\u0440\u0435\u043d\u0438 \u0438\u043b\u0438 \u043f\u0440\u0438 \u043d\u0430\u043a\u043b\u043e\u043d\u0438. \u041e\u0442 \u0434\u0440\u0443\u0433\u0430 \u0441\u0442\u0440\u0430\u043d\u0430, RM 253 \u043c\u043e\u0436\u0435 \u0434\u0430 \u043d\u0435 \u0440\u0430\u0437\u043f\u043e\u043b\u0430\u0433\u0430 \u0441 \u0442\u0430\u043a\u0430\u0432\u0430 \u0441\u0438\u0441\u0442\u0435\u043c\u0430, \u043a\u043e\u0435\u0442\u043e \u043e\u0437\u043d\u0430\u0447\u0430\u0432\u0430, \u0447\u0435 \u043f\u043e\u0442\u0440\u0435\u0431\u0438\u0442\u0435\u043b\u044f\u0442 \u0442\u0440\u044f\u0431\u0432\u0430 \u0434\u0430 \u043f\u0440\u0438\u043b\u0430\u0433\u0430 \u043f\u043e\u0432\u0435\u0447\u0435 \u0443\u0441\u0438\u043b\u0438\u044f \u0437\u0430 \u0431\u0443\u0442\u0430\u043d\u0435 \u043d\u0430 \u043a\u043e\u0441\u0430\u0447\u043a\u0430\u0442\u0430.&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;\u0426\u0435\u043d\u0430&lt;/b&gt;: \u041f\u043e\u0440\u0430\u0434\u0438 \u0434\u043e\u043f\u044a\u043b\u043d\u0438\u0442\u0435\u043b\u043d\u0430\u0442\u0430 \u0441\u0430\u043c\u043e\u0445\u043e\u0434\u043d\u0430 \u0444\u0443\u043d\u043a\u0446\u0438\u044f, RM 253 T \u043e\u0431\u0438\u043a\u043d\u043e\u0432\u0435\u043d\u043e \u0435 \u043f\u043e-\u0441\u043a\u044a\u043f\u0430 \u0432 \u0441\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0435 \u0441 RM 253.&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;\u0422\u0435\u0433\u043b\u043e \u0438 \u0443\u043f\u0440\u0430\u0432\u043b\u044f\u0435\u043c\u043e\u0441\u0442&lt;/b&gt;: \u0421\u0430\u043c\u043e\u0445\u043e\u0434\u043d\u0438\u044f\u0442 \u043c\u0435\u0445\u0430\u043d\u0438\u0437\u044a\u043c \u0432 RM 253 T \u043c\u043e\u0436\u0435 \u0434\u0430 \u0434\u043e\u0431\u0430\u0432\u0438 \u0434\u043e\u043f\u044a\u043b\u043d\u0438\u0442\u0435\u043b\u043d\u043e \u0442\u0435\u0433\u043b\u043e \u043a\u044a\u043c \u043a\u043e\u0441\u0430\u0447\u043a\u0430\u0442\u0430, \u043a\u043e\u0435\u0442\u043e \u043c\u043e\u0436\u0435 \u0434\u0430 \u043f\u043e\u0432\u043b\u0438\u044f\u0435 \u043d\u0430 \u043e\u0431\u0449\u0430\u0442\u0430 \u0443\u043f\u0440\u0430\u0432\u043b\u044f\u0435\u043c\u043e\u0441\u0442 \u0438 \u043c\u0430\u043d\u0435\u0432\u0440\u0435\u043d\u043e\u0441\u0442 \u043d\u0430 \u0443\u0440\u0435\u0434\u0430.&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;\u0423\u0434\u043e\u0431\u0441\u0442\u0432\u043e \u043f\u0440\u0438 \u0443\u043f\u043e\u0442\u0440\u0435\u0431\u0430&lt;/b&gt;: \u0411\u0435\u043d\u0437\u0438\u043d\u043e\u0432\u0430 \u043a\u043e\u0441\u0430\u0447\u043a\u0430 \u0437\u0430 \u0442\u0440\u0435\u0432\u0430 \u0429\u0438\u043b RM 253 T \u043e\u0441\u0438\u0433\u0443\u0440\u044f\u0432\u0430 \u043f\u043e-\u0432\u0438\u0441\u043e\u043a\u043e \u043d\u0438\u0432\u043e \u043d\u0430 \u0443\u0434\u043e\u0431\u0441\u0442\u0432\u043e, \u043e\u0441\u043e\u0431\u0435\u043d\u043e \u043f\u0440\u0438 \u0440\u0430\u0431\u043e\u0442\u0430 \u043d\u0430 \u0433\u043e\u043b\u0435\u043c\u0438 \u0438\u043b\u0438 \u043d\u0430\u043a\u043b\u043e\u043d\u0435\u043d\u0438 \u0442\u0440\u0435\u0432\u043d\u0438 \u043f\u043b\u043e\u0449\u0438, \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u0435\u043d\u0438\u0435 \u043d\u0430 \u0441\u0430\u043c\u043e\u0445\u043e\u0434\u043d\u0430\u0442\u0430 \u0441\u0438 \u0441\u0438\u0441\u0442\u0435\u043c\u0430.&lt;/span&gt;&lt;/li&gt;&lt;br&gt;&lt;/ul&gt;&lt;p&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;\u0418 \u0434\u0432\u0430\u0442\u0430 \u043c\u043e\u0434\u0435\u043b\u0430 \u0441\u0430 \u043f\u0440\u043e\u0435\u043a\u0442\u0438\u0440\u0430\u043d\u0438 \u0441 \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u043e\u0442\u043e \u0438 \u043d\u0430\u0434\u0435\u0436\u0434\u043d\u043e\u0441\u0442\u0442\u0430, \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u043d\u0438 \u0437\u0430 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0438\u0442\u0435 \u043d\u0430 STIHL, \u0438 \u0441\u0430 \u043f\u043e\u0434\u0445\u043e\u0434\u044f\u0449\u0438 \u0437\u0430 \u0440\u0430\u0437\u043b\u0438\u0447\u043d\u0438 \u0442\u0440\u0435\u0432\u043d\u0438 \u043f\u043b\u043e\u0449\u0438. \u0418\u0437\u0431\u043e\u0440\u044a\u0442 \u043c\u0435\u0436\u0434\u0443 RM 253 \u0438 RM 253 T \u0437\u0430\u0432\u0438\u0441\u0438 \u043e\u0442 \u043a\u043e\u043d\u043a\u0440\u0435\u0442\u043d\u0438\u0442\u0435 \u043d\u0443\u0436\u0434\u0438 \u043d\u0430 \u043f\u043e\u0442\u0440\u0435\u0431\u0438\u0442\u0435\u043b\u044f, \u043a\u0430\u0442\u043e \u0441\u0435 \u0432\u0437\u0435\u043c\u0430\u0442 \u043f\u0440\u0435\u0434\u0432\u0438\u0434 \u0444\u0430\u043a\u0442\u043e\u0440\u0438 \u043a\u0430\u0442\u043e \u0440\u0430\u0437\u043c\u0435\u0440\u0430 \u043d\u0430 \u0442\u0440\u0435\u0432\u043d\u0430\u0442\u0430 \u043f\u043b\u043e\u0449, \u0442\u043e\u043f\u043e\u0433\u0440\u0430\u0444\u0438\u044f\u0442\u0430 \u043d\u0430 \u0442\u0435\u0440\u0435\u043d\u0430 \u0438 \u043b\u0438\u0447\u043d\u0438\u0442\u0435 \u043f\u0440\u0435\u0434\u043f\u043e\u0447\u0438\u0442\u0430\u043d\u0438\u044f \u0437\u0430 \u0443\u0434\u043e\u0431\u0441\u0442\u0432\u043e \u043f\u0440\u0438 \u0440\u0430\u0431\u043e\u0442\u0430.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;h2&gt;\u0417\u0430 \u043a\u043e\u0439 \u0435 \u043f\u043e\u0434\u0445\u043e\u0434\u044f\u0449\u0430 \u0431\u0435\u043d\u0437\u0438\u043d\u043e\u0432\u0430 \u0441\u0430\u043c\u043e\u0445\u043e\u0434\u043d\u0430 \u043a\u043e\u0441\u0430\u0447\u043a\u0430 STIHL RM 253 T?&lt;/h2&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;\u0411\u0435\u043d\u0437\u0438\u043d\u043e\u0432\u0430\u0442\u0430 \u0441\u0430\u043c\u043e\u0445\u043e\u0434\u043d\u0430 \u043a\u043e\u0441\u0430\u0447\u043a\u0430 STIHL RM 253 T \u0435 \u043f\u043e\u0434\u0445\u043e\u0434\u044f\u0449\u0430 \u0437\u0430 \u0445\u043e\u0440\u0430 \u0441 \u043f\u043e-\u0433\u043e\u043b\u0435\u043c\u0438 \u0442\u0440\u0435\u0432\u043d\u0438 \u043f\u043b\u043e\u0449\u0438 \u0438 \u0437\u0430 \u0442\u0435\u0437\u0438, \u043a\u043e\u0438\u0442\u043e \u0442\u044a\u0440\u0441\u044f\u0442 \u043c\u043e\u0449\u0435\u043d \u0438 \u043d\u0430\u0434\u0435\u0436\u0434\u0435\u043d \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442 \u0437\u0430 \u043a\u043e\u0441\u0435\u043d\u0435 \u0441 \u043c\u0438\u043d\u0438\u043c\u0430\u043b\u043d\u0438 \u0443\u0441\u0438\u043b\u0438\u044f. \u0415\u0442\u043e \u043a\u043e\u0438 \u043f\u043e\u0442\u0440\u0435\u0431\u0438\u0442\u0435\u043b\u0438 \u0449\u0435 \u044f \u043d\u0430\u043c\u0435\u0440\u044f\u0442 \u043d\u0430\u0439-\u043f\u043e\u043b\u0435\u0437\u043d\u0430:&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;1. \u0421\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u0438\u0446\u0438 \u043d\u0430 \u0433\u043e\u043b\u0435\u043c\u0438 \u0434\u0432\u043e\u0440\u043e\u0432\u0435 \u0438 \u0433\u0440\u0430\u0434\u0438\u043d\u0438:&lt;/b&gt;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;\u0421 \u0440\u0430\u0431\u043e\u0442\u043d\u0430 \u0448\u0438\u0440\u0438\u043d\u0430 \u043e\u0442 51 \u0441\u043c, \u043a\u043e\u0441\u0430\u0447\u043a\u0430\u0442\u0430 \u0435 \u043f\u043e\u0434\u0445\u043e\u0434\u044f\u0449\u0430 \u0437\u0430 \u043f\u043e\u0434\u0434\u0440\u044a\u0436\u043a\u0430 \u043d\u0430 \u0442\u0440\u0435\u0432\u043d\u0438 \u043f\u043b\u043e\u0449\u0438 \u0434\u043e 1800 \u043c\u00b2, \u043a\u043e\u0435\u0442\u043e \u044f \u043f\u0440\u0430\u0432\u0438 \u0438\u0434\u0435\u0430\u043b\u043d\u0430 \u0437\u0430 \u043f\u043e-\u0433\u043e\u043b\u0435\u043c\u0438 \u0433\u0440\u0430\u0434\u0438\u043d\u0438 \u0438 \u0447\u0430\u0441\u0442\u043d\u0438 \u0438\u043c\u043e\u0442\u0438.&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;2. \u041f\u043e\u0442\u0440\u0435\u0431\u0438\u0442\u0435\u043b\u0438, \u043a\u043e\u0438\u0442\u043e \u0442\u044a\u0440\u0441\u044f\u0442 \u0443\u0434\u043e\u0431\u0441\u0442\u0432\u043e \u0438 \u043b\u0435\u043a\u043e\u0442\u0430 \u043d\u0430 \u0440\u0430\u0431\u043e\u0442\u0430:&lt;/b&gt;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;\u041a\u043e\u0441\u0430\u0447\u043a\u0430\u0442\u0430 \u0440\u0430\u0437\u043f\u043e\u043b\u0430\u0433\u0430 \u0441\u044a\u0441 \u0441\u0430\u043c\u043e\u0445\u043e\u0434\u043d\u0430 \u0444\u0443\u043d\u043a\u0446\u0438\u044f, \u043a\u043e\u0435\u0442\u043e \u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u043d\u043e \u043d\u0430\u043c\u0430\u043b\u044f\u0432\u0430 \u0443\u0441\u0438\u043b\u0438\u0435\u0442\u043e \u043f\u0440\u0438 \u043a\u043e\u0441\u0435\u043d\u0435, \u043e\u0441\u043e\u0431\u0435\u043d\u043e \u043d\u0430 \u043f\u043e-\u0433\u043e\u043b\u0435\u043c\u0438 \u0442\u0435\u0440\u0435\u043d\u0438 \u0438\u043b\u0438 \u043f\u0440\u0438 \u043d\u0435\u0440\u0430\u0432\u043d\u0438 \u043f\u043e\u0432\u044a\u0440\u0445\u043d\u043e\u0441\u0442\u0438. \u041d\u0435 \u0435 \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e \u0434\u0430 \u0431\u0443\u0442\u0430\u0442\u0435 \u043a\u043e\u0441\u0430\u0447\u043a\u0430\u0442\u0430, \u0442\u044a\u0439 \u043a\u0430\u0442\u043e \u0442\u044f \u0441\u0435 \u0434\u0432\u0438\u0436\u0438 \u0441\u0430\u043c\u0430.&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;3. \u041f\u0440\u043e\u0444\u0435\u0441\u0438\u043e\u043d\u0430\u043b\u043d\u0438 \u0433\u0440\u0430\u0434\u0438\u043d\u0430\u0440\u0438 \u0438 \u043e\u0437\u0435\u043b\u0435\u043d\u0438\u0442\u0435\u043b\u0438:&lt;/b&gt;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;\u041f\u043e\u0440\u0430\u0434\u0438 \u043c\u043e\u0449\u043d\u0438\u044f \u0431\u0435\u043d\u0437\u0438\u043d\u043e\u0432 \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b \u0438 \u0432\u044a\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u0442\u0430 \u0437\u0430 \u0435\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e \u043a\u043e\u0441\u0435\u043d\u0435 \u043d\u0430 \u0433\u043e\u043b\u0435\u043c\u0438 \u043f\u043b\u043e\u0449\u0438, \u0442\u044f \u0435 \u043f\u043e\u0434\u0445\u043e\u0434\u044f\u0449\u0430 \u0438 \u0437\u0430 \u043f\u0440\u043e\u0444\u0435\u0441\u0438\u043e\u043d\u0430\u043b\u0438\u0441\u0442\u0438, \u043a\u043e\u0438\u0442\u043e \u0441\u0435 \u0437\u0430\u043d\u0438\u043c\u0430\u0432\u0430\u0442 \u0441 \u043f\u043e\u0434\u0434\u0440\u044a\u0436\u043a\u0430 \u043d\u0430 \u043f\u0430\u0440\u043a\u043e\u0432\u0435, \u0433\u0440\u0430\u0434\u0438\u043d\u0438 \u0438 \u0437\u0435\u043b\u0435\u043d\u0438 \u043f\u043b\u043e\u0449\u0438.&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;4. \u0425\u043e\u0440\u0430, \u043a\u043e\u0438\u0442\u043e \u0442\u044a\u0440\u0441\u044f\u0442 \u0437\u0434\u0440\u0430\u0432\u0430 \u0438 \u0438\u0437\u0434\u0440\u044a\u0436\u043b\u0438\u0432\u0430 \u043a\u043e\u0441\u0430\u0447\u043a\u0430:&lt;/b&gt;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;STIHL RM 253 T \u0435 \u043e\u0431\u043e\u0440\u0443\u0434\u0432\u0430\u043d\u0430 \u0441\u044a\u0441 \u0437\u0434\u0440\u0430\u0432 \u0441\u0442\u043e\u043c\u0430\u043d\u0435\u043d \u043a\u043e\u0440\u043f\u0443\u0441, \u043a\u043e\u0439\u0442\u043e \u0435 \u0443\u0441\u0442\u043e\u0439\u0447\u0438\u0432 \u043d\u0430 \u0443\u0434\u0430\u0440\u0438 \u0438 \u0438\u0437\u043d\u043e\u0441\u0432\u0430\u043d\u0435, \u043a\u043e\u0435\u0442\u043e \u044f \u043f\u0440\u0430\u0432\u0438 \u043f\u043e\u0434\u0445\u043e\u0434\u044f\u0449\u0430 \u0437\u0430 \u043f\u0440\u043e\u0434\u044a\u043b\u0436\u0438\u0442\u0435\u043b\u043d\u0430 \u0443\u043f\u043e\u0442\u0440\u0435\u0431\u0430 \u0432 \u0442\u0435\u0436\u043a\u0438 \u0443\u0441\u043b\u043e\u0432\u0438\u044f.&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;5. \u0422\u0435\u0437\u0438, \u043a\u043e\u0438\u0442\u043e \u043f\u0440\u0435\u0434\u043f\u043e\u0447\u0438\u0442\u0430\u0442 \u0431\u0435\u043d\u0437\u0438\u043d\u043e\u0432\u0438 \u043c\u0430\u0448\u0438\u043d\u0438 \u0437\u0430 \u043f\u043e-\u0433\u043e\u043b\u044f\u043c\u0430 \u043c\u043e\u0431\u0438\u043b\u043d\u043e\u0441\u0442:&lt;/b&gt;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;\u0422\u044a\u0439 \u043a\u0430\u0442\u043e \u043a\u043e\u0441\u0430\u0447\u043a\u0430\u0442\u0430 \u0435 \u0431\u0435\u043d\u0437\u0438\u043d\u043e\u0432\u0430, \u0442\u044f \u043d\u0435 \u0437\u0430\u0432\u0438\u0441\u0438 \u043e\u0442 \u0435\u043b\u0435\u043a\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u043e \u0437\u0430\u0445\u0440\u0430\u043d\u0432\u0430\u043d\u0435 \u0438\u043b\u0438 \u0430\u043a\u0443\u043c\u0443\u043b\u0430\u0442\u043e\u0440\u0438, \u043a\u043e\u0435\u0442\u043e \u044f \u043f\u0440\u0430\u0432\u0438 \u043f\u043e\u0434\u0445\u043e\u0434\u044f\u0449\u0430 \u0437\u0430 \u043a\u043e\u0441\u0435\u043d\u0435 \u043d\u0430 \u0433\u043e\u043b\u0435\u043c\u0438 \u043f\u043b\u043e\u0449\u0438 \u0431\u0435\u0437 \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u0438\u0435 \u0432 \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0435\u0442\u043e.&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;6. \u041f\u043e\u0442\u0440\u0435\u0431\u0438\u