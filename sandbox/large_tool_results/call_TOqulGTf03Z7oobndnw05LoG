30\u0434\u0440\u0430\u0442\u043d\u0438 \u043c\u0435\u0442\u0440\u0430, \u043a\u043e\u0435\u0442\u043e \u044f \u043f\u0440\u0430\u0432\u0438 \u0438\u0434\u0435\u0430\u043b\u043d\u0430 \u0437\u0430 \u0441\u0440\u0435\u0434\u043d\u043e \u0433\u043e\u043b\u0435\u043c\u0438 \u0433\u0440\u0430\u0434\u0438\u043d\u0438 \u0438 \u0434\u0432\u043e\u0440\u043e\u0432\u0435.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;\u0420\u0435\u0433\u0443\u043b\u0438\u0440\u0443\u0435\u043c\u0430 \u0432\u0438\u0441\u043e\u0447\u0438\u043d\u0430 \u043d\u0430 \u043a\u043e\u0441\u0435\u043d\u0435: 25 - 75 \u043c\u043c&lt;/b&gt; - \u0412\u0438\u0441\u043e\u0447\u0438\u043d\u0430\u0442\u0430 \u043d\u0430 \u043a\u043e\u0441\u0435\u043d\u0435 \u043c\u043e\u0436\u0435 \u0434\u0430 \u0441\u0435 \u0440\u0435\u0433\u0443\u043b\u0438\u0440\u0430 \u0432 \u0434\u0438\u0430\u043f\u0430\u0437\u043e\u043d\u0430 \u043e\u0442 25 \u0434\u043e 75 \u043c\u043c, \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u0432\u0430\u0439\u043a\u0438 \u043d\u0430 \u043f\u043e\u0442\u0440\u0435\u0431\u0438\u0442\u0435\u043b\u0438\u0442\u0435 \u0434\u0430 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u0432\u0430\u0442 \u0436\u0435\u043b\u0430\u043d\u0430\u0442\u0430 \u0432\u0438\u0441\u043e\u0447\u0438\u043d\u0430 \u043d\u0430 \u0442\u0440\u0435\u0432\u0430\u0442\u0430 \u0441\u043f\u043e\u0440\u0435\u0434 \u043d\u0443\u0436\u0434\u0438\u0442\u0435 \u0441\u0438.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;\u041e\u0431\u0435\u043c \u043d\u0430 \u043a\u043e\u0448\u0430 \u0437\u0430 \u0442\u0440\u0435\u0432\u0430: 55 \u043b&lt;/b&gt; - \u0413\u043e\u043b\u0435\u043c\u0438\u044f\u0442 \u043a\u043e\u0448 \u0437\u0430 \u0442\u0440\u0435\u0432\u0430 \u0441 \u043e\u0431\u0435\u043c \u043e\u0442 55 \u043b\u0438\u0442\u0440\u0430 \u043e\u0437\u043d\u0430\u0447\u0430\u0432\u0430 \u043f\u043e-\u0440\u044f\u0434\u043a\u043e \u0441\u043f\u0438\u0440\u0430\u043d\u