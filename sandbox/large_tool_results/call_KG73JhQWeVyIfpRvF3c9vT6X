0442\u0432\u043e\u0440\u0432\u0430\u043d\u0435\u0442\u043e \u043d\u0430 \u0434\u0440\u043e\u0441\u0435\u043b\u0430 \u0432 \u043a\u0430\u0440\u0431\u0443\u0440\u0430\u0442\u043e\u0440\u0430 \u2013 \u043e\u0441\u0438\u0433\u0443\u0440\u044f\u0432\u0430 \u0443\u0441\u043a\u043e\u0440\u044f\u0432\u0430\u043d\u0435 \u0438\u043b\u0438 \u043d\u0430\u043c\u0430\u043b\u044f\u0432\u0430\u043d\u0435 \u043d\u0430 \u043e\u0431\u043e\u0440\u043e\u0442\u0438\u0442\u0435 \u043f\u043e \u043c\u043e\u0434\u0435\u043b\u0430 \u043d\u0430 \u043d\u0430\u0442\u0438\u0441\u043a\u0430 \u043d\u0430 \u0440\u044a\u0447\u043a\u0430\u0442\u0430;&lt;/li&gt;\r\n    &lt;li&gt;&lt;strong&gt;\u041f\u0440\u0435\u0446\u0438\u0437\u043d\u043e \u0434\u043e\u0437\u0438\u0440\u0430\u043d\u0435:&lt;/strong&gt; \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u0432\u0430 \u043f\u043b\u0430\u0432\u043d\u0430 \u0438 \u0442\u043e\u0447\u043d\u0430 \u043a\u043e\u0440\u0435\u043a\u0446\u0438\u044f \u043f\u0440\u0438 \u0441\u0442\u0430\u0440\u0442\u0438\u0440\u0430\u043d\u0435, \u043a\u043e\u0441\u0435\u043d\u0435 \u0438 \u043f\u0440\u0438 \u0441\u043c\u044f\u043d\u0430 \u043d\u0430 \u043f\u043e\u0432\u044a\u0440\u0445\u043d\u043e\u0441\u0442\u0438\u0442\u0435 (\u0442\u0440\u0435\u0432\u0430, \u0445\u0440\u0430\u0441\u0442\u0438 \u0438 \u0434\u0440.);&lt;/li&gt;\r\n    &lt;li&gt;&lt;strong&gt;\u041a\u043e\u043d\u0442\u0440\u043e\u043b \u043d\u0430 \u043c\u043e\u0449\u043d\u043e\u0441\u0442\u0442\u0430:&lt;/strong&gt; \u043e\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u044a\u0442 \u043f\u043e\u043b\u0443\u0447\u0430\u0432\u0430 \u0432\u044a\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442 \u0434\u0430 \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u044f\u0432\u0430 \u043e\u0431\u043e\u0440\u043e\u0442\u0438\u0442\u0435 \u0441\u043f\u0440\u044f\u043c\u043e \u043d\u0430\u0442\u043e\u0432\u0430\u0440\u0432\u0430\u043d\u0435\u0442\u043e \u2013 \u043f\u043e-\u043d\u0438\u0441\u043a\u0438 \u043f\u0440\u0438 \u0440\u044f\u0437\u0430\u043d\u0435 \u0431\u043b\u0438\u0437\u043e \u0434\u043e \u0437\u0435\u043c\u044f\u0442\u0430, \u043f\u043e-\u0432\u0438\u0441\u043e\u043a\u0438 \u043f\u0440\u0438 \u0434\u0435\u0431\u0435\u043b\u0430 \u0442\u0440\u0435\u0432\u0430.&lt;/li&gt;\r\n  &lt;/ul&gt;\r\n\r\n  &lt;h2 style=&quot;font-family: &amp;quot;Open Sans&amp;quot;, sans-serif; font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/h2&gt;&lt;h2 style=&quot;&quot;&gt;\u041a\u0430\u043a\u0432\u0430 \u0435 \u0440\u043e\u043b\u044f\u0442\u0430 \u043c\u0443?&lt;/h2&gt;&lt;p style=&quot;font-family: &amp;quot;Open Sans&amp;quot;, sans-serif; font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/p&gt;\r\n  &lt;ul style=&quot;font-family: &amp;quot;Open Sans&amp;quot;, sans-serif; font-size: 14px;&quot;&gt;\r\n    &lt;li&gt;&lt;strong&gt;\u0421\u0438\u0433\u0443\u0440\u043d\u043e\u0441\u0442:&lt;/strong&gt; \u0438\u0437\u043f\u0440\u0430\u0432\u043d\u043e \u0436\u0438\u0442\u043b\u043e \u043f\u0440\u0435\u0434\u043e\u0442\u0432\u0440\u0430\u0442\u044f\u0432\u0430 \u043d\u0435\u0436\u0435\u043b\u0430\u043d\u043e \u0443\u0441\u043a\u043e\u0440\u044f\u0432\u0430\u043d\u0435 \u0438 \u043c\u0438\u043d\u0438\u043c\u0438\u0437\u0438\u0440\u0430 \u0440\u0438\u0441\u043a\u0430 \u043e\u0442 \u0438\u043d\u0446\u0438\u0434\u0435\u043d\u0442\u0438;&lt;/li&gt;\r\n    &lt;li&gt;&lt;strong&gt;\u0415\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442:&lt;/strong&gt; \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u0432\u0430 \u0438\u0437\u043f\u043e\u043b\u0437\u0432\u0430\u043d\u0435 \u043d\u0430 \u043e\u043f\u0442\u0438\u043c\u0430\u043b\u043d\u0438 \u043e\u0431\u043e\u0440\u043e\u0442\u0438 \u0441\u043f\u043e\u0440\u0435\u0434 \u0443\u0441\u043b\u043e\u0432\u0438\u044f\u0442\u0430 \u2013 \u0438\u043a\u043e\u043d\u043e\u043c\u0438\u044f \u043d\u0430 \u0433\u043e\u0440\u0438\u0432\u043e \u0438 \u043f\u043e-\u0434\u044a\u043b\u044a\u0433 \u0436\u0438\u0432\u043e\u0442 \u043d\u0430 \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044f;&lt;/li&gt;\r\n 