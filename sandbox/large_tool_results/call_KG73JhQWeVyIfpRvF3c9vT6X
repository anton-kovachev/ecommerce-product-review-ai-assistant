d\u043e\u0432\u0438\u044f \u0432\u0430\u043b.&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;\u041e\u0441\u0438\u0433\u0443\u0440\u044f\u0432\u0430\u043d\u0435 \u043d\u0430 \u0446\u0438\u043a\u043b\u0438\u0447\u0435\u043d \u043f\u0440\u043e\u0446\u0435\u0441&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;\u0427\u0435\u0442\u0438\u0440\u0438 \u0442\u0430\u043a\u0442\u0430 \u043d\u0430 \u0440\u0430\u0431\u043e\u0442\u0430: \u0411\u0443\u0442\u0430\u043b\u043e\u0442\u043e \u043f\u0440\u0435\u043c\u0438\u043d\u0430\u0432\u0430 \u043f\u0440\u0435\u0437 \u0447\u0435\u0442\u0438\u0440\u0438 \u043e\u0441\u043d\u043e\u0432\u043d\u0438 \u0435\u0442\u0430\u043f\u0430 (\u0442.\u043d\u0430\u0440. \u0442\u0430\u043a\u0442\u0438) \u0432 \u0440\u0430\u0431\u043e\u0442\u043d\u0438\u044f \u0441\u0438 \u0446\u0438\u043a\u044a\u043b:&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;\u0422\u0430\u043a\u044a\u0442 \u043d\u0430 \u0432\u0441\u043c\u0443\u043a\u0432\u0430\u043d\u0435: \u0411\u0443\u0442\u0430\u043b\u043e\u0442\u043e \u0441\u0435 \u0434\u0432\u0438\u0436\u0438 \u043d\u0430\u0434\u043e\u043b\u0443, \u0441\u044a\u0437\u0434\u0430\u0432\u0430\u0439\u043a\u0438 \u0432\u0430\u043a\u0443\u0443\u043c, \u043a\u043e\u0439\u0442\u043e \u0432\u0441\u043c\u0443\u043a\u0432\u0430 \u0432\u044a\u0437\u0434\u0443\u0448\u043d\u043e-\u0433\u043e\u0440\u0438\u0432\u043d\u0430\u0442\u0430 \u0441\u043c\u0435\u0441 \u0432 \u0446\u0438\u043b\u0438\u043d\u0434\u044a\u0440\u0430.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;\u0422\u0430\u043a\u044a\u0442 \u043d\u0430 \u043a\u043e\u043c\u043f\u0440\u0435\u0441\u0438\u044f: \u0411\u0443\u0442\u0430\u043b\u043e\u0442\u043e \u0441\u0435 \u0434\u0432\u0438\u0436\u0438 \u043d\u0430\u0433\u043e\u0440\u0435, \u043a\u043e\u043c\u043f\u0440\u0435\u0441\u0438\u0440\u0430\u0439\u043a\u0438 \u0441\u043c\u0435\u0441\u0442\u0430.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;\u0422\u0430\u043a\u044a\u0442 \u043d\u0430 \u0440\u0430\u0431\u043e\u0442\u0435\u043d \u0445\u043e\u0434: \u0421\u043b\u0435\u0434 \u0437\u0430\u043f\u0430\u043b\u0432\u0430\u043d\u0435\u0442\u043e \u043d\u0430 \u0441\u043c\u0435\u0441\u0442\u0430, \u0431\u0443\u0442\u0430\u043b\u043e\u0442\u043e \u0441\u0435 \u0438\u0437\u0431\u0443\u0442\u0432\u0430 \u043d\u0430\u0434\u043e\u043b\u0443 \u043e\u0442 \u0435\u043a\u0441\u043f\u043b\u043e\u0437\u0438\u044f\u0442\u0430, \u0441\u044a\u0437\u0434\u0430\u0432\u0430\u0439\u043a\u0438 \u043c\u043e\u0449\u043d\u043e\u0441\u0442\u0442\u0430.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;\u0422\u0430\u043a\u044a\u0442 \u043d\u0430 \u0438\u0437\u043f\u0443\u0441\u043a\u0430\u043d\u0435: \u0411\u0443\u0442\u0430\u043b\u043e\u0442\u043e \u0441\u0435 \u0434\u0432\u0438\u0436\u0438 \u043e\u0431\u0440\u0430\u0442\u043d\u043e \u043d\u0430\u0433\u043e\u0440\u0435, \u0438\u0437\u0442\u043b\u0430\u0441\u043a\u0432\u0430\u0439\u043a\u0438 \u0438\u0437\u0433\u043e\u0440\u0435\u043b\u0438\u0442\u0435 \u0433\u0430\u0437\u043e\u0432\u0435 \u0438\u0437\u0432\u044a\u043d \u0446\u0438\u043b\u0438\u043d\u0434\u044a\u0440\u0430.&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;\u0417\u043d\u0430\u0447\u0435\u043d\u0438\u0435 \u043d\u0430 \u0434\u0438\u0430\u043c\u0435\u0442\u044a\u0440\u0430&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;\u0414\u0438\u0430\u043c\u0435\u0442\u044a\u0440 34 \u043c\u043c&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-