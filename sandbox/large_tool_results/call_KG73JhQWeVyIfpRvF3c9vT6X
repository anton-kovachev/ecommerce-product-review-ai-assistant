\u0442\u0430 \u043d\u0430 \u0442\u0440\u0438\u043c\u0435\u0440 \u0437\u0430 \u0442\u0440\u0435\u0432\u0430 FS 40 \u043f\u0440\u0435\u0434 FS 38?&lt;/h2&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;\u0422\u0440\u0438\u043c\u0435\u0440\u044a\u0442 \u0437\u0430 \u0442\u0440\u0435\u0432\u0430 STIHL FS 40 \u043f\u0440\u0435\u0434\u043e\u0441\u0442\u0430\u0432\u044f \u043d\u044f\u043a\u043e\u0438 \u043f\u0440\u0435\u0434\u0438\u043c\u0441\u0442\u0432\u0430 \u0432 \u0441\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0435 \u0441 \u043c\u043e\u0434\u0435\u043b\u0430 FS 38:&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;\u041f\u043e-\u043c\u043e\u0449\u0435\u043d \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b&lt;/b&gt;: STIHL FS 40 \u0440\u0430\u0437\u043f\u043e\u043b\u0430\u0433\u0430 \u0441 \u043f\u043e-\u043c\u043e\u0449\u0435\u043d \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b, \u043a\u043e\u0439\u0442\u043e \u043f\u0440\u0435\u0434\u043e\u0441\u0442\u0430\u0432\u044f \u043f\u043e-\u0433\u043e\u043b\u044f\u043c \u043e\u0431\u0435\u043c \u043d\u0430 \u0440\u0430\u0431\u043e\u0442\u0430\u0442\u0430 \u0438 \u0435 \u043f\u043e-\u0435\u0444\u0438\u043a\u0430\u0441\u0435\u043d \u043f\u0440\u0438 \u043f\u043e-\u0433\u043e\u043b\u0435\u043c\u0438 \u0438 \u043f\u043e-\u0442\u0435\u0436\u043a\u0438 \u0437\u0430\u0434\u0430\u0447\u0438.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;\u041f\u043e-\u0433\u043e\u043b\u044f\u043c \u0440\u0430\u0431\u043e\u0442\u0435\u043d \u043e\u0431\u0445\u0432\u0430\u0442&lt;/b&gt;: \u041f\u043e-\u0433\u043e\u043b\u044f\u043c\u0430\u0442\u0430 \u043c\u043e\u0449\u043d\u043e\u0441\u0442 \u043d\u0430 FS 40 \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u0432\u0430 \u043d\u0430 \u043f\u043e\u0442\u0440\u0435\u0431\u0438\u0442\u0435\u043b\u0438\u0442\u0435 \u0434\u0430 \u0441\u0435 \u0441\u043f\u0440\u0430\u0432\u044f\u0442 \u0441 \u043f\u043e-\u0433\u043e\u043b\u0435\u043c\u0438 \u0438 \u043f\u043e-\u0442\u0440\u0443\u0434\u043d\u0438 \u0442\u0440\u0435\u0432\u043d\u0438 \u043f\u043b\u043e\u0449\u0438 \u0438\u043b\u0438 \u0442\u0435\u0440\u0435\u043d\u0438.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;\u041f\u043e-\u0433\u043e\u043b\u044f\u043c\u0430 \u0438\u0437\u0434\u044a\u0440\u0436\u043b\u0438\u0432\u043e\u0441\u0442&lt;/b&gt;: \u0417\u0430 \u0440\u0430\u0437\u043b\u0438\u043a\u0430 \u043e\u0442 FS 38, FS 40 \u0438\u043c\u0430 \u043f\u043e-\u0433\u043e\u043b\u044f\u043c \u0440\u0435\u0437\u0435\u0440\u0432\u043e\u0430\u0440 \u0437\u0430 \u0433\u043e\u0440\u0438\u0432\u043e, \u043a\u043e\u0435\u0442\u043e \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u0432\u0430 \u043f\u043e-\u0434\u044a\u043b\u0433\u0438 \u043f\u0435\u0440\u0438\u043e\u0434\u0438 \u043d\u0430 \u0440\u0430\u0431\u043e\u0442\u0430 \u043f\u0440\u0435\u0434\u0438 \u0434\u0430 \u0431\u044a\u0434\u0435 \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e \u0434\u0430 \u0441\u0435 \u0437\u0430\u0440\u0435\u0436\u0434\u0430.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;\u041f\u043e-\u0433\u043e\u043b\u044f\u043c \u043a\u043e\u043c\u0444\u043e\u0440\u0442 \u043f\u0440\u0438 \u0443\u043f\u043e\u0442\u0440\u0435\u0431\u0430&lt;/b&gt;: \u0429\u0438\u043b FS 40 \u0435 \u043e\u0431\u043e\u0440\u0443\u0434\u0432\u0430\u043d \u0441 \u043f\u043e-\u0443\u0434\u043e\u0431\u043d\u0430 \u0440\u044a\u043a\u043e\u0445\u0432\u0430\u0442\u043a\u0430 \u0438 \u0441\u0438\u0441\u0442\u0435\u043c\u0430 \u0437\u0430 \u0430\u043d\u0442\u0438\u0432\u0438\u0431\u0440\u0430\u0446\u0438\u044f, \u043a\u043e\u044f\u0442\u043e \u043e\u0441\u0438\u0433\u0443\u0440\u044f\u0432\u0430 \u043f\u043e-\u0433\u043e\u043b\u044f\u043c \u043a\u043e\u043