7\u0430 \u0443\u043f\u043e\u0442\u0440\u0435\u0431\u0430 \u0442\u0440\u0438\u043c\u0435\u0440 \u0437\u0430 \u0442\u0440\u0435\u0432\u0430, \u043f\u043e\u0434\u0445\u043e\u0434\u044f\u0449 \u0437\u0430 \u0448\u0438\u0440\u043e\u043a \u0441\u043f\u0435\u043a\u0442\u044a\u0440 \u043e\u0442 \u0433\u0440\u0430\u0434\u0438\u043d\u0430\u0440\u0441\u043a\u0438 \u0437\u0430\u0434\u0430\u0447\u0438. \u0421\u044a\u0441 \u0441\u0432\u043e\u044f\u0442\u0430 \u043b\u0435\u043a\u0430 \u043a\u043e\u043d\u0441\u0442\u0440\u0443\u043a\u0446\u0438\u044f, \u043c\u043e\u0449\u0435\u043d \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b \u0438 \u0443\u0434\u043e\u0431\u043d\u0438 \u0444\u0443\u043d\u043a\u0446\u0438\u0438, \u0442\u0430\u0437\u0438 \u043c\u043e\u0442\u043e\u0440\u043d\u0430 \u043a\u043e\u0441\u0430 \u0435 \u043e\u0442\u043b\u0438\u0447\u0435\u043d \u0438\u0437\u0431\u043e\u0440 \u0437\u0430 \u0432\u0441\u0435\u043a\u0438 \u0433\u0440\u0430\u0434\u0438\u043d\u0430\u0440, \u043a\u043e\u0439\u0442\u043e \u0442\u044a\u0440\u0441\u0438 \u0435\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442 \u0438 \u043a\u043e\u043c\u0444\u043e\u0440\u0442 \u043f\u0440\u0438 \u043f\u043e\u0434\u0434\u0440\u044a\u0436\u043a\u0430 \u043d\u0430 \u0442\u0440\u0435\u0432\u043d\u0438 \u043f\u043b\u043e\u0449\u0438.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;h2&gt;\u0417\u0430 \u043a\u043e\u0439 \u0435 \u043f\u043e\u0434\u0445\u043e\u0434\u044f\u0449 \u0431\u0435\u043d\u0437\u0438\u043d\u043e\u0432\u0438\u044f\u0442 \u0442\u0440\u0438\u043c\u0435\u0440 STIHL FS 40?&lt;/h2&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;\u0411\u0435\u043d\u0437\u0438\u043d\u043e\u0432\u0438\u044f\u0442 \u0442\u0440\u0438\u043c\u0435\u0440 STIHL FS 40 \u0435 \u043f\u043e\u0434\u0445\u043e\u0434\u044f\u0449 \u0437\u0430 \u0434\u043e\u043c\u0430\u0448\u043d\u0438 \u0438 \u043f\u043e\u043b\u0443-\u043f\u0440\u043e\u0444\u0435\u0441\u0438\u043e\u043d\u0430\u043b\u043d\u0438 \u043f\u043e\u0442\u0440\u0435\u0431\u0438\u0442\u0435\u043b\u0438, \u043a\u043e\u0438\u0442\u043e \u0438\u043c\u0430\u0442 \u043d\u0443\u0436\u0434\u0430 \u043e\u0442 \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442 \u0437\u0430 \u0440\u044f\u0437\u0430\u043d\u0435 \u0438 \u043f\u043e\u0434\u0434\u0440\u044a\u0436\u043a\u0430 \u043d\u0430 \u0442\u0440\u0435\u0432\u043d\u0438 \u043f\u043b\u043e\u0449\u0438, \u0442\u0440\u0435\u0432\u043d\u0438\u0446\u0438\u0442\u0435 \u043e\u043a\u043e\u043b\u043e \u0434\u044a\u0440\u0432\u0435\u0442\u0430, \u0436\u0438\u0432 \u043f\u043b\u0435\u0442 \u0438 \u0434\u0440\u0443\u0433\u0438 \u043f\u043e\u0434\u043e\u0431\u043d\u0438 \u0440\u0430\u0431\u043e\u0442\u0438 \u0432 \u0433\u0440\u0430\u0434\u0438\u043d\u0430\u0442\u0430 \u0438\u043b\u0438 \u043d\u0430 \u043e\u0442\u043a\u0440\u0438\u0442\u043e. \u0422\u043e\u0439 \u0435 \u043f\u0440\u0435\u0434\u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d \u0437\u0430 \u0441\u043b\u0435\u0434\u043d\u0438\u0442\u0435 \u0437\u0430\u0434\u0430\u0447\u0438:&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;\u041a\u043e\u0441\u0435\u043d\u0435 \u043d\u0430 \u0442\u0440\u0435\u0432\u0430&lt;/b&gt;: STIHL FS 40 \u0435 \u0438\u0434\u0435\u0430\u043b\u0435\u043d \u0437\u0430 \u0440\u044f\u0437\u0430\u043d\u0435 \u043d\u0430 \u0442\u0440\u0435\u0432\u043d\u0438 \u043f\u043b\u043e\u0449\u0438 \u0438 \u043e\u0431\u0440\u0430\u0431\u043e\u0442\u043a\u0430 \u043d\u0430 \u0433\u0440\u0430\u0434\u0438\u043d\u0441\u043a\u0438 \u0442\u0440\u0435\u0432\u043d\u0438\u0446\u0438.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;\u041f\u043e\u0434\u0434\u0440\u044a\u0436\u043a\u0430 \u043d\u0430 \u0436\u0438\u0432 \u043f\u043b\u0435\u0442&lt;/b&gt;: \u041c\u043e\u0436\u0435\u0442\u0435 \u0434\u0430 \u0438\u0437\u043f\u043e\u043b\u0437\u0432\u04