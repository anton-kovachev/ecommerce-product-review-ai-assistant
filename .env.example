OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# OpenCart access. Set OPENCART_SSH_HOST=ddev when using DDEV, or provide
# the SSH host and user for a remote OpenCart server.
OPENCART_SSH_HOST=
OPENCART_SSH_USER=
OPENCART_SSH_KEY=~/.ssh/id_ed25519
OPENCART_SSH_KEY_PASS=
OPENCART_SSH_PORT=22
OPENCART_ROOT=
OPENCART_STORAGE=

# Optional if the corresponding DB_* values are available in OpenCart config.php.
OPENCART_DB_HOST=
OPENCART_DB_USER=
OPENCART_DB_PASS=
OPENCART_DB_NAME=
OPENCART_DB_PREFIX=

# Optional: required only when using Pushover notifications.
PUSHOVER_TOKEN=
PUSHOVER_USER=
